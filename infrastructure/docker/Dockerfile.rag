# ==========================================================================
# LIBERTASIAN RAG Service — Multi-stage production Dockerfile
# Python 3.12 + FastAPI + httpx
# ==========================================================================

# Stage 1: Dependencies
FROM python:3.12-slim AS deps

# Install uv for fast dependency management
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app

# Lockfile first so the layer caches on source-only changes.
COPY services/rag-service/pyproject.toml services/rag-service/uv.lock ./

# --frozen fails the build if the lock and pyproject.toml have drifted.
#
# This previously ran `uv pip install -r pyproject.toml`, which ignored uv.lock
# and re-resolved from PyPI on every rebuild. Because the constraints here are
# lower bounds only (fastapi>=0.115.0), each rebuild could land a different
# version than the one that was tested: a rebuild resolved fastapi 0.141 against
# a lock pinning 0.135.1 and every route 500'd for ~50 minutes.
RUN uv sync --frozen --no-dev --no-install-project

# Stage 2: Production
FROM python:3.12-slim AS runner

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# The locked dependency set lives in the venv built by `uv sync`, not in the
# interpreter's site-packages. PATH puts its bin dir first so the CMD below
# resolves the locked uvicorn rather than a system one.
COPY --from=deps /app/.venv /app/.venv
ENV PATH="/app/.venv/bin:$PATH"

# Copy application source
COPY services/rag-service/src ./src

# Non-root user
RUN groupadd -g 1001 appgroup && useradd -u 1001 -g appgroup -s /bin/sh appuser
USER appuser

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
