# ==========================================================================
# LIBERTASIAN TTS Service — Multi-stage production Dockerfile
# Python 3.12 + FastAPI + Kokoro-82M
#
# CPU-ONLY BY CONSTRUCTION. The prod VPS is 12 vCPU AMD EPYC / 47 GB RAM with
# NO GPU, so torch is declared explicitly in pyproject.toml and pinned to the
# CPU wheel index; this image never derives from a CUDA base.
# ==========================================================================

# Stage 1: Dependencies
FROM python:3.12-slim AS deps

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app

# Lockfile first so the layer caches on source-only changes.
COPY services/tts-service/pyproject.toml services/tts-service/uv.lock ./

# --frozen fails the build if the lock and pyproject.toml have drifted.
RUN uv sync --frozen --no-dev --no-install-project

# Stage 2: Production
FROM python:3.12-slim AS runner

# espeak-ng is Kokoro's grapheme-to-phoneme fallback for out-of-vocabulary
# words — without it, unusual legal terms silently degrade. (LAME is statically
# bundled in the lameenc wheel, so no libmp3lame package is needed.)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    espeak-ng \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=deps /app/.venv /app/.venv
ENV PATH="/app/.venv/bin:$PATH"

COPY services/tts-service/src ./src

# Model weights live on a writable cache dir owned by the runtime user.
ENV HF_HOME=/app/.cache/huggingface
RUN groupadd -g 1001 appgroup \
    && useradd -u 1001 -g appgroup -s /bin/sh appuser \
    && mkdir -p "$HF_HOME" \
    && chown -R appuser:appgroup /app
USER appuser

# Bake the Kokoro weights and the default voice into the image. This RUN is
# deliberately AFTER `USER appuser` so every cache file is owned by the runtime
# user — a root-owned cache is unreadable-for-write at runtime and re-downloads.
#
# Without this, HF_HOME is created EMPTY and no compose volume backs it, so the
# weights re-download from HuggingFace on every container recreate and the
# service cannot start at all when HF is unreachable.
#
# Constructing the pipeline also loads misaki's spaCy G2P, so this line fails
# the BUILD if en_core_web_sm is missing instead of returning 500 from every
# /synthesize while /health still reports ok.
#
# ACCEPTANCE: `docker run --network none` this image and confirm BOTH /health
# AND a real multi-segment /synthesize succeed. A 500 from /synthesize means the
# bake is incomplete — /health alone proves nothing, because G2P and the voice
# tensor are both loaded lazily on first synthesis.
RUN python -c "\
import spacy; spacy.load('en_core_web_sm');\
from kokoro import KPipeline;\
from src.config import settings;\
p = KPipeline(lang_code='a', repo_id=settings.tts_model_repo);\
p.load_voice(settings.tts_default_voice);\
print('preloaded', settings.tts_model_repo, settings.tts_default_voice)"

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

EXPOSE 8003

# Model load is ~13s cold, so allow a generous start period before probing.
HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=60s \
    CMD curl -f http://localhost:8003/health || exit 1

CMD ["sh", "-c", "uvicorn src.main:app --host 0.0.0.0 --port 8003 --workers ${TTS_WORKERS:-2}"]
