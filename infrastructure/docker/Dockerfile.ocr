# ==========================================================================
# LIBERTASIAN OCR Service — Multi-stage production Dockerfile
# Python 3.12 + Tesseract 5 + OpenCV + FastAPI
# ==========================================================================

# Stage 1: Dependencies
FROM python:3.12-slim AS deps

# Install system dependencies for Tesseract and OpenCV
RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr \
    tesseract-ocr-eng \
    libleptonica-dev \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Install uv for fast dependency management
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app

# Lockfile first so the layer caches on source-only changes.
COPY services/ocr-service/pyproject.toml services/ocr-service/uv.lock ./

# --frozen fails the build if the lock and pyproject.toml have drifted.
#
# This previously ran `uv pip install -r pyproject.toml`, which ignored uv.lock
# and re-resolved from PyPI on every rebuild. The constraints here are lower
# bounds only, so each rebuild could land a different version than the one that
# was tested — the failure mode that took rag-service down for ~50 minutes and
# was fixed there in #368.
RUN uv sync --frozen --no-dev --no-install-project

# Stage 2: Production
FROM python:3.12-slim AS runner

# Install runtime-only system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr \
    tesseract-ocr-eng \
    libleptonica-dev \
    libgl1 \
    libglib2.0-0 \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# The locked dependency set lives in the venv built by `uv sync`, not in the
# interpreter's site-packages. PATH puts its bin dir first so the CMD below
# resolves the locked uvicorn rather than a system one.
COPY --from=deps /app/.venv /app/.venv
ENV PATH="/app/.venv/bin:$PATH"

# Copy application source
COPY services/ocr-service/src ./src

# Non-root user
RUN groupadd -g 1001 appgroup && useradd -u 1001 -g appgroup -s /bin/sh appuser
USER appuser

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

EXPOSE 8002

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD curl -f http://localhost:8002/health || exit 1

CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8002", "--workers", "2"]
