# ==========================================================================
# LIBERTASIAN Web — Multi-stage production Dockerfile
# ==========================================================================

# Stage 1: Dependencies
FROM node:22-alpine AS deps
RUN corepack enable && corepack prepare pnpm@10 --activate
WORKDIR /app

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json .npmrc ./
COPY apps/web/package.json apps/web/package.json
COPY packages/tsconfig/package.json packages/tsconfig/package.json
COPY packages/types/package.json packages/types/package.json

RUN pnpm install --frozen-lockfile --prod=false

# Stage 2: Build
FROM node:22-alpine AS builder
RUN corepack enable && corepack prepare pnpm@10 --activate
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/web/node_modules ./apps/web/node_modules
COPY --from=deps /app/packages/types/node_modules ./packages/types/node_modules
COPY . .
RUN mkdir -p /app/apps/web/public

ARG NEXT_PUBLIC_API_URL=https://libertasian.com/api/v1
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

ARG NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
ENV NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=$NEXT_PUBLIC_GOOGLE_AUTH_ENABLED

ARG NEXT_PUBLIC_FEATURE_BAR_EXAM_ANSWERS_PUBLIC=false
ENV NEXT_PUBLIC_FEATURE_BAR_EXAM_ANSWERS_PUBLIC=$NEXT_PUBLIC_FEATURE_BAR_EXAM_ANSWERS_PUBLIC

# PayMongo PUBLISHABLE key. The browser uses it to tokenize cards directly
# against PayMongo, so card data never reaches our servers (PCI scope).
# NEXT_PUBLIC_* vars are inlined at BUILD time, so this needs BOTH the ARG/ENV
# here AND a build arg in docker-compose.prod.yml. With either one missing the
# value is undefined at runtime and the /billing/authorize page fails silently.
ARG NEXT_PUBLIC_PAYMONGO_PUBLIC_KEY=
ENV NEXT_PUBLIC_PAYMONGO_PUBLIC_KEY=$NEXT_PUBLIC_PAYMONGO_PUBLIC_KEY

# Build shared workspace packages web imports at runtime (dist/ is gitignored
# and NOT produced by `next build`). Must precede the web build.
RUN pnpm --filter @libertasian/types build

RUN pnpm --filter @libertasian/web build

# Stage 3: Production
FROM node:22-alpine AS runner
RUN apk add --no-cache dumb-init
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

COPY --from=builder /app/apps/web/.next/standalone ./
COPY --from=builder /app/apps/web/.next/static ./apps/web/.next/static
# public dir may be empty in early phases — ensure it exists before copying
RUN mkdir -p ./apps/web/public
COPY --from=builder /app/apps/web/public/ ./apps/web/public/

# Non-root user
RUN addgroup -g 1001 -S nodejs && adduser -S nextjs -u 1001
USER nextjs

EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
CMD ["dumb-init", "node", "apps/web/server.js"]
