# ==========================================================================
# LIBERTASIAN Worker Service — Multi-stage production Dockerfile
# Python 3.12 + Tesseract 5 + Celery + S3/DB clients
# ==========================================================================

# Stage 1: Dependencies
FROM python:3.12-slim AS deps

# Install system dependencies (Tesseract for worker-side OCR fallback, OpenCV)
RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr \
    tesseract-ocr-eng \
    libleptonica-dev \
    libgl1 \
    libglib2.0-0 \
    libpq-dev \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Install uv for fast dependency management
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app

# Lockfile first so the layer caches on source-only changes.
COPY services/worker-service/pyproject.toml services/worker-service/uv.lock ./

# --frozen fails the build if the lock and pyproject.toml have drifted.
#
# This previously ran `uv pip install -r pyproject.toml`, which ignored uv.lock
# and re-resolved from PyPI on every rebuild. The constraints here are lower
# bounds only, so each rebuild could land a different version than the one that
# was tested — the failure mode that took rag-service down for ~50 minutes and
# was fixed there in #368.
RUN uv sync --frozen --no-dev --no-install-project

# Stage 2: Production
FROM python:3.12-slim AS runner

# Install runtime-only system dependencies.
# procps (pgrep) is required for the beat container's healthcheck override
# in docker-compose, which tests for a live "celery ... beat" process rather
# than pinging workers (the default `celery inspect ping` doesn't respond on
# a beat-only container and was causing libertasian-worker-beat to be marked
# unhealthy in production).
RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr \
    tesseract-ocr-eng \
    libleptonica-dev \
    libgl1 \
    libglib2.0-0 \
    libpq5 \
    curl \
    procps \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# The locked dependency set lives in the venv built by `uv sync`, not in the
# interpreter's site-packages. PATH puts its bin dir first so the CMD and
# HEALTHCHECK below resolve the locked celery — as does the `celery ... beat`
# command that docker-compose substitutes for the beat container.
COPY --from=deps /app/.venv /app/.venv
ENV PATH="/app/.venv/bin:$PATH"

# Copy application source
COPY services/worker-service/src ./src

# Non-root user
RUN groupadd -g 1001 appgroup && useradd -u 1001 -g appgroup -s /bin/sh appuser
RUN chown -R appuser:appgroup /app
USER appuser

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

HEALTHCHECK --interval=30s --timeout=30s --retries=3 \
    CMD celery -A src.celery_app inspect ping --timeout 10 || exit 1

# Run Celery worker with concurrency=2 (per PDD: parallel OCR pages)
CMD ["celery", "-A", "src.celery_app", "worker", "--loglevel=info", "--concurrency=2"]
