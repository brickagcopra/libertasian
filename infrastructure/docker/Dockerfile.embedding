# ==========================================================================
# LIBERTASIAN Embedding Service — Multi-stage production Dockerfile
# Python 3.12 + FastAPI + sentence-transformers
# ==========================================================================

# Stage 1: Dependencies
FROM python:3.12-slim AS deps

# Install uv for fast dependency management
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app

# Lockfile first so the layer caches on source-only changes.
COPY services/embedding-service/pyproject.toml services/embedding-service/uv.lock ./

# --frozen fails the build if the lock and pyproject.toml have drifted.
#
# This previously ran `uv pip install -r pyproject.toml`, which ignored uv.lock
# and re-resolved from PyPI on every rebuild. The constraints here are lower
# bounds only, so each rebuild could land a different version than the one that
# was tested — the failure mode that took rag-service down for ~50 minutes and
# was fixed there in #368.
RUN uv sync --frozen --no-dev --no-install-project

# Stage 2: Production
FROM python:3.12-slim AS runner

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# The locked dependency set lives in the venv built by `uv sync`, not in the
# interpreter's site-packages. PATH puts its bin dir first so the CMD below
# resolves the locked uvicorn rather than a system one.
COPY --from=deps /app/.venv /app/.venv
ENV PATH="/app/.venv/bin:$PATH"

# Copy application source
COPY services/embedding-service/src ./src

# Non-root user. useradd here does not pass -m, so /home/appuser is not
# created automatically. HuggingFace Hub writes to $HOME/.cache/huggingface
# on every model download — without the directory, the first request fails
# with PermissionError and the model never loads. Create the cache dir
# explicitly and chown to appuser before dropping privileges.
RUN groupadd -g 1001 appgroup && useradd -u 1001 -g appgroup -s /bin/sh appuser \
    && mkdir -p /home/appuser/.cache/huggingface \
    && chown -R appuser:appgroup /home/appuser
USER appuser

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
# Pin HuggingFace cache location so any future tooling that overrides $HOME
# still resolves the cache to the directory we just provisioned.
ENV HF_HOME=/home/appuser/.cache/huggingface

EXPOSE 8001

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD curl -f http://localhost:8001/health || exit 1

CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8001", "--workers", "2"]
