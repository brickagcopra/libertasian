# ==========================================================================
# LIBERTASIAN — Alertmanager Configuration (template)
#
# Rendered at container start by the alertmanager entrypoint in
# docker-compose.monitoring.yml: __SMTP_USER__ is replaced from $SMTP_USER and
# $SMTP_PASS is written to /tmp/smtp_pass. No secrets live in this file.
# ==========================================================================

global:
  resolve_timeout: 5m

route:
  group_by: ['alertname', 'severity']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  receiver: 'default'
  routes:
    - match:
        severity: critical
      receiver: 'critical'
      repeat_interval: 1h
    - match:
        severity: warning
      receiver: 'default'
      repeat_interval: 4h

receivers:
  - name: 'default'
    email_configs:
      - to: 'support@libertasian.com'
        from: 'LIBERTASIAN Alerts <noreply@libertasian.com>'
        smarthost: 'smtp-relay.brevo.com:587'
        auth_username: '__SMTP_USER__'
        auth_password_file: '/tmp/smtp_pass'
        require_tls: true
        send_resolved: true

  - name: 'critical'
    email_configs:
      - to: 'support@libertasian.com'
        from: 'LIBERTASIAN Alerts <noreply@libertasian.com>'
        smarthost: 'smtp-relay.brevo.com:587'
        auth_username: '__SMTP_USER__'
        auth_password_file: '/tmp/smtp_pass'
        require_tls: true
        send_resolved: true

inhibit_rules:
  - source_match:
      severity: 'critical'
    target_match:
      severity: 'warning'
    equal: ['alertname']
