{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "AI Query Volume",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(rag_queries_total{job=\"rag-service\"}[5m])) by (intent_type)",
          "legendFormat": "{{ intent_type }}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "title": "Generation Latency (P50 / P95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(rag_generation_duration_seconds_bucket{job=\"rag-service\"}[5m])) by (le))",
          "legendFormat": "P50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(rag_generation_duration_seconds_bucket{job=\"rag-service\"}[5m])) by (le))",
          "legendFormat": "P95"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "title": "Token Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(rag_tokens_input_total{job=\"rag-service\"}[5m]))",
          "legendFormat": "Input Tokens/s"
        },
        {
          "expr": "sum(rate(rag_tokens_output_total{job=\"rag-service\"}[5m]))",
          "legendFormat": "Output Tokens/s"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "title": "Abstention Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(rag_abstention_total{job=\"rag-service\"}[5m])) / sum(rate(rag_queries_total{job=\"rag-service\"}[5m])) * 100",
          "legendFormat": "Abstention Rate"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent" } }
    },
    {
      "title": "Confidence Score Distribution",
      "type": "histogram",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(rag_confidence_score_bucket{job=\"rag-service\"}[5m])) by (le)",
          "legendFormat": "{{ le }}"
        }
      ]
    },
    {
      "title": "OCR Processing",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(ocr_pages_processed_total{job=\"ocr-service\"}[5m]))",
          "legendFormat": "Pages/s"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(ocr_processing_duration_seconds_bucket{job=\"ocr-service\"}[5m])) by (le))",
          "legendFormat": "P95 Latency"
        }
      ]
    },
    {
      "title": "Embedding Generation Rate",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "sum(rate(embedding_vectors_generated_total{job=\"embedding-service\"}[5m]))",
          "legendFormat": "Vectors/s"
        }
      ]
    },
    {
      "title": "Ingestion Pipeline",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 24 },
      "targets": [
        {
          "expr": "sum(rate(ingestion_job_total{job=\"worker\"}[1h])) by (status)",
          "legendFormat": "{{ status }}"
        }
      ]
    },
    {
      "title": "Review Queue Depth",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 30 },
      "targets": [
        {
          "expr": "review_queue_pending_count",
          "legendFormat": "Pending Reviews"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 50 }, { "color": "red", "value": 100 }] }
        }
      }
    },
    {
      "title": "Corpus Size",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 30 },
      "targets": [
        {
          "expr": "libertasian_corpus_document_count",
          "legendFormat": "Documents"
        }
      ]
    },
    {
      "title": "Search Relevance (MRR@10)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 30 },
      "targets": [
        {
          "expr": "rag_search_mrr_at_10",
          "legendFormat": "MRR@10"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.5 }, { "color": "green", "value": 0.65 }] }
        }
      }
    }
  ],
  "schemaVersion": 39,
  "tags": ["libertasian", "ai"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "title": "LIBERTASIAN — AI Pipeline",
  "uid": "libertasian-ai-pipeline"
