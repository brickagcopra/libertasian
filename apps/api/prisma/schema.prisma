// ==========================================================================
// 5.11 Coupon System
// ==========================================================================

model Coupon {
  id                     String    @id @default(uuid()) @db.Uuid
  code                   String    @unique @db.VarChar(50)
  codeHash               String    @map("code_hash") @db.VarChar(64)
  // SHA-256 of uppercase normalized code for consistent lookups
  name                   String    @db.VarChar(255)
  description            String?
  internalNotes          String?   @map("internal_notes")
  discountType           String    @map("discount_type") @db.VarChar(30)
  // discountType: percentage, fixed_amount, bonus_credit, trial_extension
  discountValue          Int       @map("discount_value")
  // percentage 1-100, centavos for fixed_amount, bonus qty for bonus_credit, days for trial_extension
  currency               String    @default("PHP") @db.VarChar(3)
  appliesToBillingPeriod String    @default("any") @map("applies_to_billing_period") @db.VarChar(10)
  // appliesToBillingPeriod: any, monthly, annual
  maxRedemptions         Int?      @map("max_redemptions")
  // global limit, null = unlimited
  maxRedemptionsPerOrg   Int       @default(1) @map("max_redemptions_per_org")
  currentRedemptions     Int       @default(0) @map("current_redemptions")
  startsAt               DateTime? @map("starts_at") @db.Timestamptz
  expiresAt              DateTime? @map("expires_at") @db.Timestamptz
  isActive               Boolean   @default(true) @map("is_active")
  isArchived             Boolean   @default(false) @map("is_archived")
  minimumPlanTier        String?   @map("minimum_plan_tier") @db.VarChar(30)
  // nullable — e.g. 'edu' means only edu+ can use
  bonusEntitlementKey    String?   @map("bonus_entitlement_key") @db.VarChar(100)
  // for bonus_credit type, e.g. 'aiAnswers'
  bonusEntitlementValue  Int?      @map("bonus_entitlement_value")
  // for bonus_credit type
  bonusDurationDays      Int?      @map("bonus_duration_days")
  // how long the bonus lasts
  trialExtensionDays     Int?      @map("trial_extension_days")
  // for trial_extension type
  metadataJson           Json      @default("{}") @map("metadata_json")
  createdByUserId        String    @map("created_by_user_id") @db.Uuid
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  createdBy              User                    @relation("CouponCreatedBy", fields: [createdByUserId], references: [id])
  redemptions            CouponRedemption[]
  planRules              CouponPlanRule[]
  userAssignments        CouponUserAssignment[]
  orgAssignments         CouponOrgAssignment[]
  checkoutPriceSnapshots CheckoutPriceSnapshot[]

  @@index([code], map: "idx_coupon_code")
  @@index([codeHash], map: "idx_coupon_code_hash")
  @@index([isActive, isArchived], map: "idx_coupon_active_archived")
  @@index([startsAt, expiresAt], map: "idx_coupon_date_range")
  @@map("coupons")
}

model CouponRedemption {
  id                    String    @id @default(uuid()) @db.Uuid
  couponId              String    @map("coupon_id") @db.Uuid
  organizationId        String    @map("organization_id") @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  subscriptionId        String?   @map("subscription_id") @db.Uuid
  paymentId             String?   @unique @map("payment_id") @db.Uuid
  status                String    @default("reserved") @db.VarChar(20)
  // status: reserved, redeemed, rolled_back, expired
  discountAmountApplied Int?      @map("discount_amount_applied")
  // actual discount applied at checkout in centavos
  originalAmount        Int?      @map("original_amount")
  // price before discount in centavos
  reservedAt            DateTime  @default(now()) @map("reserved_at") @db.Timestamptz
  redeemedAt            DateTime? @map("redeemed_at") @db.Timestamptz
  rolledBackAt          DateTime? @map("rolled_back_at") @db.Timestamptz
  expiresAt             DateTime  @map("expires_at") @db.Timestamptz
  // reservation TTL
  metadataJson          Json      @default("{}") @map("metadata_json")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  coupon       Coupon        @relation(fields: [couponId], references: [id])
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User          @relation("CouponRedemptionUser", fields: [userId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  payment      Payment?      @relation(fields: [paymentId], references: [id])

  @@index([couponId, organizationId], map: "idx_redemption_coupon_org")
  @@index([couponId, status], map: "idx_redemption_coupon_status")
  @@index([organizationId, status], map: "idx_redemption_org_status")
  @@index([status, expiresAt], map: "idx_redemption_status_expiry")
  @@map("coupon_redemptions")
}

model CouponPlanRule {
  id       String @id @default(uuid()) @db.Uuid
  couponId String @map("coupon_id") @db.Uuid
  planCode String @map("plan_code") @db.VarChar(50)
  ruleType String @map("rule_type") @db.VarChar(10)
  // ruleType: include, exclude

  // Relations
  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@unique([couponId, planCode], map: "uq_coupon_plan_rule")
  @@map("coupon_plan_rules")
}

model CouponUserAssignment {
  id         String    @id @default(uuid()) @db.Uuid
  couponId   String    @map("coupon_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  assignedAt DateTime  @default(now()) @map("assigned_at") @db.Timestamptz
  claimedAt  DateTime? @map("claimed_at") @db.Timestamptz

  // Relations
  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation("CouponUserAssignment", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId], map: "uq_coupon_user_assignment")
  @@map("coupon_user_assignments")
}

model CouponOrgAssignment {
  id             String    @id @default(uuid()) @db.Uuid
  couponId       String    @map("coupon_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  assignedAt     DateTime  @default(now()) @map("assigned_at") @db.Timestamptz
  claimedAt      DateTime? @map("claimed_at") @db.Timestamptz

  // Relations
  coupon       Coupon       @relation(fields: [couponId], references: [id], onDelete: Cascade)
  organization Organization @relation("CouponOrgAssignment", fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([couponId, organizationId], map: "uq_coupon_org_assignment")
  @@map("coupon_org_assignments")
}

// ==========================================================================
// 5.5b Promotion System (auto-applied, rule-based campaigns)
// ==========================================================================

model Promotion {
  id                     String    @id @default(uuid()) @db.Uuid
  name                   String    @db.VarChar(255)
  slug                   String    @unique @db.VarChar(100)
  // URL-safe slug for pricing page display
  description            String?
  internalNotes          String?   @map("internal_notes")
  promotionType          String    @map("promotion_type") @db.VarChar(30)
  // promotionType: sale, bonus, trial_extension, combined
  status                 String    @default("draft") @db.VarChar(20)
  // status: draft, scheduled, active, paused, expired, archived
  priority               Int       @default(0)
  // higher = evaluated first for conflict resolution
  startsAt               DateTime? @map("starts_at") @db.Timestamptz
  endsAt                 DateTime? @map("ends_at") @db.Timestamptz
  // nullable = no end date
  maxRedemptions         Int?      @map("max_redemptions")
  // global limit, null = unlimited
  maxRedemptionsPerOrg   Int       @default(1) @map("max_redemptions_per_org")
  currentRedemptions     Int       @default(0) @map("current_redemptions")
  isStackableWithCoupons Boolean   @default(false) @map("is_stackable_with_coupons")
  isStackableWithPromos  Boolean   @default(false) @map("is_stackable_with_promos")
  isDisplayedOnPricing   Boolean   @default(false) @map("is_displayed_on_pricing")
  // true = show on pricing page
  metadataJson           Json      @default("{}") @map("metadata_json")
  createdByUserId        String    @map("created_by_user_id") @db.Uuid
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  createdBy              User                    @relation("PromotionCreatedBy", fields: [createdByUserId], references: [id])
  rules                  PromotionRule[]
  benefits               PromotionBenefit[]
  redemptions            PromotionRedemption[]
  planRules              PromotionPlanRule[]
  checkoutPriceSnapshots CheckoutPriceSnapshot[]

  @@index([status, startsAt, endsAt], map: "idx_promotion_status_dates")
  @@index([status, priority], map: "idx_promotion_status_priority")
  @@index([isDisplayedOnPricing, status], map: "idx_promotion_display_status")
  @@map("promotions")
}

model PromotionRule {
  id            String  @id @default(uuid()) @db.Uuid
  promotionId   String  @map("promotion_id") @db.Uuid
  ruleType      String  @map("rule_type") @db.VarChar(30)
  // ruleType: date_range, organization_type, subscription_status,
  //   redemption_limit, new_subscriber, billing_period, minimum_tier, stacking
  configuration Json    @default("{}") @db.JsonB
  // per-rule-type JSON configuration
  ordering      Int     @default(0)
  // evaluation order within a promotion
  isActive      Boolean @default(true) @map("is_active")

  // Relations
  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@index([promotionId, isActive], map: "idx_promo_rule_promo_active")
  @@map("promotion_rules")
}

model PromotionBenefit {
  id                     String  @id @default(uuid()) @db.Uuid
  promotionId            String  @map("promotion_id") @db.Uuid
  benefitType            String  @map("benefit_type") @db.VarChar(30)
  // benefitType: percentage_discount, fixed_discount, bonus_credit, trial_extension
  discountValue          Int?    @map("discount_value")
  // percentage 1-100 for percentage_discount, centavos for fixed_discount
  bonusEntitlementKey    String? @map("bonus_entitlement_key") @db.VarChar(100)
  // for bonus_credit, e.g. 'aiAnswers'
  bonusEntitlementValue  Int?    @map("bonus_entitlement_value")
  // for bonus_credit, e.g. 100 extra answers
  bonusDurationDays      Int?    @map("bonus_duration_days")
  // how long the bonus lasts
  trialExtensionDays     Int?    @map("trial_extension_days")
  // for trial_extension type
  appliesToBillingPeriod String  @default("any") @map("applies_to_billing_period") @db.VarChar(10)
  // appliesToBillingPeriod: any, monthly, annual

  // Relations
  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@index([promotionId], map: "idx_promo_benefit_promo")
  @@map("promotion_benefits")
}

model PromotionRedemption {
  id                    String    @id @default(uuid()) @db.Uuid
  promotionId           String    @map("promotion_id") @db.Uuid
  organizationId        String    @map("organization_id") @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  subscriptionId        String?   @map("subscription_id") @db.Uuid
  paymentId             String?   @unique @map("payment_id") @db.Uuid
  status                String    @default("applied") @db.VarChar(20)
  // status: applied, revoked (no reservation phase — promos are system-applied)
  discountAmountApplied Int?      @map("discount_amount_applied")
  // actual discount applied in centavos
  originalAmount        Int?      @map("original_amount")
  // price before discount in centavos
  benefitsAppliedJson   Json      @default("{}") @map("benefits_applied_json")
  // snapshot of benefits at redemption time
  revokedAt             DateTime? @map("revoked_at") @db.Timestamptz
  revokeReason          String?   @map("revoke_reason")
  metadataJson          Json      @default("{}") @map("metadata_json")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz

  // Relations
