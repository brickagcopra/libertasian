// Monthly SaaS metrics snapshot
model SaasMetricsMonthly {
  id         String   @id @default(uuid()) @db.Uuid
  periodId   String   @unique @map("period_id") @db.Uuid
  periodDate DateTime @unique @map("period_date") @db.Date
  // First day of the month, e.g. 2026-01-01

  // MRR breakdown (all centavos)
  mrr            Int @default(0)
  mrrNew         Int @default(0) @map("mrr_new")
  mrrExpansion   Int @default(0) @map("mrr_expansion")
  mrrContraction Int @default(0) @map("mrr_contraction")
  mrrChurn       Int @default(0) @map("mrr_churn")
  arr            Int @default(0)
  netNewMrr      Int @default(0) @map("net_new_mrr")

  // Subscriber counts
  subscriberCount    Int @default(0) @map("subscriber_count")
  newSubscribers     Int @default(0) @map("new_subscribers")
  churnedSubscribers Int @default(0) @map("churned_subscribers")

  // Churn & retention rates (stored as basis points, e.g. 250 = 2.50%)
  revenueChurnRate Int @default(0) @map("revenue_churn_rate")
  logoChurnRate    Int @default(0) @map("logo_churn_rate")
  nrr              Int @default(0)
  // Net revenue retention in basis points
  grr              Int @default(0)
  // Gross revenue retention in basis points

  // Unit economics (centavos where applicable)
  arpu             Int @default(0)
  cac              Int @default(0)
  ltv              Int @default(0)
  ltvCacRatio      Int @default(0) @map("ltv_cac_ratio")
  // stored as ratio × 100, e.g. 350 = 3.5x
  cacPaybackMonths Int @default(0) @map("cac_payback_months")

  // Profitability (basis points for percentages, centavos for amounts)
  grossMarginPercent     Int @default(0) @map("gross_margin_percent")
  operatingMarginPercent Int @default(0) @map("operating_margin_percent")
  ruleOf40               Int @default(0) @map("rule_of_40")
  // Rule of 40 score in basis points

  // Cash metrics (centavos)
  burnRate     Int @default(0) @map("burn_rate")
  runwayMonths Int @default(0) @map("runway_months")

  // P&L summary (centavos)
  totalRevenue Int @default(0) @map("total_revenue")
  totalCogs    Int @default(0) @map("total_cogs")
  grossProfit  Int @default(0) @map("gross_profit")
  totalOpex    Int @default(0) @map("total_opex")
  netIncome    Int @default(0) @map("net_income")

  // Balance sheet highlights (centavos)
  cashBalance            Int @default(0) @map("cash_balance")
  deferredRevenueBalance Int @default(0) @map("deferred_revenue_balance")
  arBalance              Int @default(0) @map("ar_balance")

  // Flexible additional data
  data Json @default("{}") @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  period AccountingPeriod @relation(fields: [periodId], references: [id])

  @@index([periodDate], map: "idx_saas_metrics_period_date")
  @@map("saas_metrics_monthly")
}

