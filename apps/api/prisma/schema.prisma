  fromState      String   @map("from_state") @db.VarChar(30)
  toState        String   @map("to_state") @db.VarChar(30)
  fromPlanCode   String?  @map("from_plan_code") @db.VarChar(50)
  toPlanCode     String?  @map("to_plan_code") @db.VarChar(50)
  reason         String?
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  actorType      String   @map("actor_type") @db.VarChar(20)
