model Matter {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  ownerUserId    String   @map("owner_user_id") @db.Uuid
  title          String   @db.VarChar(500)
  description    String?
  matterType     String?  @map("matter_type") @db.VarChar(50)
  court          String?  @db.VarChar(255)
  status         String   @default("active") @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner            User              @relation(fields: [ownerUserId], references: [id])
  documents        MatterDocument[]
  notes            Note[]
  tasks            Task[]
  comments         MatterComment[]
  legalMemos       LegalMemo[]
  pleadings        Pleading[]
  caseComparisons  CaseComparison[]
  caseTimelines    CaseTimeline[]
  hearingPrepPacks HearingPrepPack[]

  @@map("matters")
}

model MatterDocument {
  id              String   @id @default(uuid()) @db.Uuid
  matterId        String   @map("matter_id") @db.Uuid
  legalDocumentId String?  @map("legal_document_id") @db.Uuid
  userUploadId    String?  @map("user_upload_id") @db.Uuid
  title           String?  @db.VarChar(500)
  role            String   @default("reference") @db.VarChar(20)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  matter        Matter         @relation(fields: [matterId], references: [id], onDelete: Cascade)
  legalDocument LegalDocument? @relation(fields: [legalDocumentId], references: [id])
  userUpload    UserUpload?    @relation(fields: [userUploadId], references: [id])

  @@map("matter_documents")
}

model Note {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  matterId       String?  @map("matter_id") @db.Uuid
  title          String?  @db.VarChar(500)
  body           Json     @default("{}")
  visibility     String   @default("private") @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])
  matter       Matter?      @relation(fields: [matterId], references: [id])

  @@map("notes")
}

model Bookmark {
  id                     String   @id @default(uuid()) @db.Uuid
  userId                 String   @map("user_id") @db.Uuid
  legalDocumentId        String   @map("legal_document_id") @db.Uuid
  legalDocumentSectionId String?  @map("legal_document_section_id") @db.Uuid
  note                   String?
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  legalDocument LegalDocument         @relation(fields: [legalDocumentId], references: [id])
  section       LegalDocumentSection? @relation(fields: [legalDocumentSectionId], references: [id])

  @@map("bookmarks")
}

model Annotation {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  legalDocumentId String   @map("legal_document_id") @db.Uuid
  sectionId       String?  @map("section_id") @db.Uuid
  textAnchor      Json     @map("text_anchor")
  annotationText  String?  @map("annotation_text")
  color           String?  @default("yellow") @db.VarChar(20)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  legalDocument LegalDocument         @relation(fields: [legalDocumentId], references: [id])
  section       LegalDocumentSection? @relation(fields: [sectionId], references: [id])

  @@map("annotations")
}

model Task {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  matterId         String?   @map("matter_id") @db.Uuid
  createdByUserId  String    @map("created_by_user_id") @db.Uuid
  assignedToUserId String?   @map("assigned_to_user_id") @db.Uuid
  title            String    @db.VarChar(500)
  description      String?
  status           String    @default("todo") @db.VarChar(20)
  // status: todo, in_progress, done, cancelled
  priority         String    @default("medium") @db.VarChar(10)
  // priority: low, medium, high, urgent
  dueDate          DateTime? @map("due_date") @db.Timestamptz
  completedAt      DateTime? @map("completed_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  matter       Matter?       @relation(fields: [matterId], references: [id], onDelete: SetNull)
  createdBy    User          @relation("TaskCreatedBy", fields: [createdByUserId], references: [id])
  assignedTo   User?         @relation("TaskAssignedTo", fields: [assignedToUserId], references: [id])
  comments     TaskComment[]

  @@index([organizationId, status], map: "idx_tasks_org_status")
  @@index([assignedToUserId], map: "idx_tasks_assignee")
  @@index([matterId], map: "idx_tasks_matter")
  @@index([dueDate], map: "idx_tasks_due_date")
  @@map("tasks")
}

model TaskComment {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([taskId], map: "idx_task_comments_task")
  @@map("task_comments")
}

model MatterComment {
  id        String   @id @default(uuid()) @db.Uuid
  matterId  String   @map("matter_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  matter Matter @relation(fields: [matterId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([matterId], map: "idx_matter_comments_matter")
  @@map("matter_comments")
}

model WorkspaceShare {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  entityType      String    @map("entity_type") @db.VarChar(20)
  // entity_type: matter
  entityId        String    @map("entity_id") @db.Uuid
  tokenHash       String    @unique @map("token_hash") @db.VarChar(128)
  permission      String    @default("view") @db.VarChar(10)
  // permission: view, comment, edit
  passwordHash    String?   @map("password_hash") @db.VarChar(255)
