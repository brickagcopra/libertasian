  // null = platform-wide aggregate
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([date, metricName, dimension, organizationId], map: "uq_daily_aggregate")
  @@index([date], map: "idx_daily_aggregate_date")
  @@index([metricName], map: "idx_daily_aggregate_metric")
  @@index([organizationId], map: "idx_daily_aggregate_org")
  @@map("analytics_daily_aggregates")
}

model AnalyticsFunnelStep {
  id                String   @id @default(uuid()) @db.Uuid
  funnelName        String   @map("funnel_name") @db.VarChar(100)
  stepName          String   @map("step_name") @db.VarChar(100)
  stepOrder         Int      @map("step_order")
  date              DateTime @db.Date
  enteredCount      Int      @default(0) @map("entered_count")
  completedCount    Int      @default(0) @map("completed_count")
