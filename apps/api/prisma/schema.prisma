// ==========================================================================
// LIBERTASIAN — Prisma Schema
// All 30+ models from PDD Section 5
// PostgreSQL 16 + pgvector
// ==========================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================================================
// 5.1 Core Identity & Tenancy
// ==========================================================================

model User {
  id                        String    @id @default(uuid()) @db.Uuid
  email                     String    @unique @db.VarChar(255)
  passwordHash              String?   @map("password_hash") @db.VarChar(255)
  fullName                  String    @map("full_name") @db.VarChar(255)
  phone                     String?   @db.VarChar(50)
  status                    String    @default("active") @db.VarChar(20)
  emailVerified             Boolean   @default(false) @map("email_verified")
  emailVerifyToken          String?   @map("email_verify_token") @db.VarChar(255)
  emailVerifyTokenExpiresAt DateTime? @map("email_verify_token_expires_at") @db.Timestamptz
  mfaEnabled                Boolean   @default(false) @map("mfa_enabled")
  mfaSecret                 String?   @map("mfa_secret") @db.VarChar(500)
  googleId                  String?   @unique @map("google_id") @db.VarChar(255)
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                 DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  onboardingCompletedAt     DateTime? @map("onboarding_completed_at") @db.Timestamptz
  userRole                  String?   @map("user_role") @db.VarChar(30)
  lastLoginAt               DateTime? @map("last_login_at") @db.Timestamptz
  lastLoginIp               String?   @map("last_login_ip") @db.VarChar(64)
  lastLoginCountry          String?   @map("last_login_country") @db.VarChar(8)
  lastLoginCity             String?   @map("last_login_city") @db.VarChar(128)
  lastLoginRegion           String?   @map("last_login_region") @db.VarChar(64)

  // Relations
  ownedOrganizations         Organization[]            @relation("BillingOwner")
  memberships                OrganizationMember[]
  refreshTokens              RefreshToken[]
  loginEvents                LoginEvent[]
  passwordResets             PasswordReset[]
  digests                    Digest[]
  notes                      Note[]
  bookmarks                  Bookmark[]
  annotations                Annotation[]
  uploads                    UserUpload[]
  digestReviews              DigestReview[]
  derivativeReviews          DerivativeReview[]
  matters                    Matter[]
  auditLogs                  AuditLog[]
  flashcardSets              FlashcardSet[]
  reviewerPacks              ReviewerPack[]
  studyProgress              StudyProgress[]
  tasksCreated               Task[]                    @relation("TaskCreatedBy")
  tasksAssigned              Task[]                    @relation("TaskAssignedTo")
  taskComments               TaskComment[]
  matterComments             MatterComment[]
  workspaceShares            WorkspaceShare[]
  assignedDigestReviews      Digest[]                  @relation("DigestAssignedReviewer")
  caseCodalLinks             CaseCodalLink[]
  legalMemos                 LegalMemo[]
  pleadings                  Pleading[]
  caseComparisons            CaseComparison[]
  caseTimelines              CaseTimeline[]
  hearingPrepPacks           HearingPrepPack[]
  contradictionReports       ContradictionReport[]
  researchWorkspaces         ResearchWorkspace[]
  apiKeys                    ApiKey[]
  flashcardReviews           FlashcardReview[]
  studyStreak                StudyStreak?
  studySessions              StudySession[]
  notifications              Notification[]
  communityRatings           CommunityRating[]
  communityVotes             CommunityVote[]
  communityFlags             CommunityFlag[]           @relation("CommunityFlagReporter")
  communityFlagsResolved     CommunityFlag[]           @relation("CommunityFlagResolver")
  expertVerification         ExpertVerification?
  assignedMemberRoles        MemberRole[]              @relation("MemberRoleAssignedBy")
  subscriptionHistoryActions SubscriptionHistory[]     @relation("HistoryActor")
  complimentaryGranted       ComplimentaryAccess[]     @relation("ComplimentaryGrantedBy")
  complimentaryRevoked       ComplimentaryAccess[]     @relation("ComplimentaryRevokedBy")
  initiatedMigrations        SubscriptionMigration[]   @relation("MigrationInitiatedBy")
  overridesCreated           EntitlementOverride[]     @relation("OverrideCreatedBy")
  overridesRevoked           EntitlementOverride[]     @relation("OverrideRevokedBy")
  couponsCreated             Coupon[]                  @relation("CouponCreatedBy")
  couponRedemptions          CouponRedemption[]        @relation("CouponRedemptionUser")
  couponUserAssignments      CouponUserAssignment[]    @relation("CouponUserAssignment")
  promotionsCreated          Promotion[]               @relation("PromotionCreatedBy")
  promotionRedemptions       PromotionRedemption[]     @relation("PromotionRedemptionUser")
  similarityReviews          DocumentSimilarity[]      @relation("SimilarityReviewer")
  triggeredIngestionJobs     IngestionJob[]            @relation("IngestionJobTriggeredBy")
  feedPosts                  FeedPost[]                @relation("FeedPostAuthor")
  feedPostMedia              FeedPostMedia[]           @relation("FeedMediaOwner")
  feedComments               FeedComment[]             @relation("FeedCommentAuthor")
  feedPostLikes              FeedPostLike[]            @relation("FeedPostLikeUser")
  feedCommentLikes           FeedCommentLike[]         @relation("FeedCommentLikeUser")
  feedPostBookmarks          FeedPostBookmark[]        @relation("FeedPostBookmarkUser")
  feedPostReports            FeedPostReport[]          @relation("FeedPostReportReporter")
  feedPostReportsResolved    FeedPostReport[]          @relation("FeedPostReportResolver")
  exportJobs                 ExportJob[]
  // Accounting relations
  accountingPeriodsClosedBy  AccountingPeriod[]        @relation("PeriodClosedBy")
  journalEntriesPostedBy     JournalEntry[]            @relation("JournalEntryPostedBy")
  journalEntriesVoidedBy     JournalEntry[]            @relation("JournalEntryVoidedBy")
  expensesCreatedBy          ExpenseRecord[]           @relation("ExpenseCreatedBy")
  expensesApprovedBy         ExpenseRecord[]           @relation("ExpenseApprovedBy")
  financialForecasts         FinancialForecast[]       @relation("ForecastCreatedBy")
  emailPreference            EmailPreference?
  aiSettingsUpdated          AiSettings[]
  blogPosts                  BlogPost[]                @relation("BlogPostAuthor")
  adCampaigns                AdCampaign[]              @relation("AdCampaignCreator")
  // Derivative artifacts (§2.2)
  derivativeArtifactsCreated DerivativeArtifact[]      @relation("DerivativeCreatedBy")
  derivativeJobsTriggered    DerivativeGenerationJob[] @relation("DerivativeJobTriggeredBy")
  createdBackfillBatches     BackfillBatch[]           @relation("BackfillBatchCreatedBy")
  // Golden sets (PR 4.1)
  goldenSetReviews           GoldenSetEntry[]          @relation("GoldenSetReviewer")
  // Bar exam answer reviews (Phase 3a)
  barExamAnswerReviews       BarExamAnswer[]           @relation("BarExamAnswerReviewer")

  @@map("users")
}

model EmailPreference {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @unique @map("user_id") @db.Uuid
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactional       Boolean  @default(true)
  subscriptionUpdates Boolean  @default(true) @map("subscription_updates")
  announcements       Boolean  @default(true)
  blogNotifications   Boolean  @default(true) @map("blog_notifications")
  unsubscribeToken    String   @unique @map("unsubscribe_token") @db.VarChar(255)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("email_preferences")
}

model RefreshToken {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  tokenHash         String   @map("token_hash") @db.VarChar(128)
  familyId          String   @map("family_id") @db.Uuid
  deviceFingerprint String?  @map("device_fingerprint") @db.VarChar(500)
  isRevoked         Boolean  @default(false) @map("is_revoked")
  replacedByTokenId String?  @map("replaced_by_token_id") @db.Uuid
  expiresAt         DateTime @map("expires_at") @db.Timestamptz
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash], map: "idx_refresh_token_hash")
  @@index([userId], map: "idx_refresh_token_user")
  @@index([familyId], map: "idx_refresh_token_family")
  @@map("refresh_tokens")
}

model LoginEvent {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  // login_success | login_failed | google_login | token_refresh | logout
  // | password_reset_used | mfa_challenge_passed | mfa_challenge_failed
  eventType         String   @map("event_type") @db.VarChar(40)
  ipAddress         String?  @map("ip_address") @db.VarChar(64)
  userAgent         String?  @map("user_agent") @db.Text
  country           String?  @db.VarChar(8)
  region            String?  @db.VarChar(64)
  city              String?  @db.VarChar(128)
  latitude          Float?
  longitude         Float?
  deviceFingerprint String?  @map("device_fingerprint") @db.VarChar(500)
  failureReason     String?  @map("failure_reason") @db.VarChar(255)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)], map: "idx_login_event_user_created")
  @@index([createdAt], map: "idx_login_event_created")
  @@index([ipAddress], map: "idx_login_event_ip")
  @@map("login_events")
}

model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash], map: "idx_password_reset_token")
  @@map("password_resets")
}

model Organization {
  id                 String   @id @default(uuid()) @db.Uuid
  name               String   @db.VarChar(255)
  slug               String   @unique @db.VarChar(100)
  type               String   @default("individual") @db.VarChar(20)
  billingOwnerUserId String?  @map("billing_owner_user_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  billingOwner                User?                        @relation("BillingOwner", fields: [billingOwnerUserId], references: [id])
  members                     OrganizationMember[]
  subscriptions               Subscription[]
  paymentMethods              PaymentMethod[]
  payments                    Payment[]
  invoices                    Invoice[]
  pendingInvites              PendingInvite[]
  digests                     Digest[]
  matters                     Matter[]
  notes                       Note[]
  uploads                     UserUpload[]
  auditLogs                   AuditLog[]
  flashcardSets               FlashcardSet[]
  reviewerPacks               ReviewerPack[]
  tasks                       Task[]
  workspaceShares             WorkspaceShare[]
  legalMemos                  LegalMemo[]
  pleadings                   Pleading[]
  caseComparisons             CaseComparison[]
  caseTimelines               CaseTimeline[]
  hearingPrepPacks            HearingPrepPack[]
  contradictionReports        ContradictionReport[]
  researchWorkspaces          ResearchWorkspace[]
  apiKeys                     ApiKey[]
  notifications               Notification[]
  roleDefinitions             RoleDefinition[]
  subscriptionHistory         SubscriptionHistory[]
  subscriptionLifecycleEvents SubscriptionLifecycleEvent[]
  trialRecords                TrialRecord[]
  complimentaryAccess         ComplimentaryAccess[]
  subscriptionMigrations      SubscriptionMigration[]
  entitlementOverrides        EntitlementOverride[]
  couponRedemptions           CouponRedemption[]
  couponOrgAssignments        CouponOrgAssignment[]        @relation("CouponOrgAssignment")
  promotionRedemptions        PromotionRedemption[]
  checkoutPriceSnapshots      CheckoutPriceSnapshot[]
  feedPosts                   FeedPost[]
  feedComments                FeedComment[]
  feedPostMedia               FeedPostMedia[]
  exportJobs                  ExportJob[]
  // Accounting relations
  journalEntryLines           JournalEntryLine[]
  revenueSchedules            RevenueSchedule[]
  // Derivative artifacts (§2.2)
  derivativeArtifacts         DerivativeArtifact[]

  @@map("organizations")
}

model OrganizationMember {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  role           String   @default("member") @db.VarChar(20)
  status         String   @default("active") @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberRoles  MemberRole[]

  @@unique([organizationId, userId])
  @@map("organization_members")
}

model Subscription {
  id                   String    @id @default(uuid()) @db.Uuid
  organizationId       String    @map("organization_id") @db.Uuid
  planCode             String    @map("plan_code") @db.VarChar(50)
  planId               String?   @map("plan_id") @db.Uuid
  status               String    @default("active") @db.VarChar(20)
  billingPeriod        String    @default("monthly") @map("billing_period") @db.VarChar(20)
  currentPeriodStart   DateTime? @map("current_period_start") @db.Timestamptz
  currentPeriodEnd     DateTime? @map("current_period_end") @db.Timestamptz
  seats                Int       @default(1)
  entitlementsJson     Json      @default("{}") @map("entitlements_json")
  // Xendit Customer id (reusable across re-subscriptions for the same org).
  xenditCustomerId     String?   @map("xendit_customer_id") @db.VarChar(255)
  xenditSubscriptionId String?   @unique @map("xendit_subscription_id") @db.VarChar(255)
  cancelAtPeriodEnd    Boolean   @default(false) @map("cancel_at_period_end")
  canceledAt           DateTime? @map("canceled_at") @db.Timestamptz
  trialStart           DateTime? @map("trial_start") @db.Timestamptz
  trialEnd             DateTime? @map("trial_end") @db.Timestamptz
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  organization         Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan                 Plan?                        @relation(fields: [planId], references: [id])
  payments             Payment[]
  invoices             Invoice[]
  history              SubscriptionHistory[]
  lifecycleEvents      SubscriptionLifecycleEvent[]
  trialRecords         TrialRecord[]
  complimentaryAccess  ComplimentaryAccess[]
  migrationsFrom       SubscriptionMigration[]      @relation("MigrationFrom")
  migrationsTo         SubscriptionMigration[]      @relation("MigrationTo")
  couponRedemptions    CouponRedemption[]
  promotionRedemptions PromotionRedemption[]
  // Accounting relations
  journalEntryLines    JournalEntryLine[]
  revenueSchedules     RevenueSchedule[]

  @@index([planId], map: "idx_subscriptions_plan")
  @@index([organizationId], map: "idx_subscriptions_org")
  @@index([status], map: "idx_subscriptions_status")
  @@index([organizationId, status], map: "idx_subscriptions_org_status")
  @@index([createdAt(sort: Desc)], map: "idx_subscriptions_created_desc")
  @@map("subscriptions")
}

model PaymentMethod {
  id                    String   @id @default(uuid()) @db.Uuid
  organizationId        String   @map("organization_id") @db.Uuid
  xenditPaymentMethodId String   @unique @map("xendit_payment_method_id") @db.VarChar(255)
  type                  String   @db.VarChar(20)
  // type: card, gcash, maya
  brand                 String?  @db.VarChar(50)
  last4                 String?  @db.VarChar(4)
  expiryMonth           Int?     @map("expiry_month")
  expiryYear            Int?     @map("expiry_year")
  billingEmail          String?  @map("billing_email") @db.VarChar(255)
  isDefault             Boolean  @default(false) @map("is_default")
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payments     Payment[]

  @@index([organizationId], map: "idx_payment_methods_org")
  @@map("payment_methods")
}

model Payment {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  subscriptionId  String?   @map("subscription_id") @db.Uuid
  paymentMethodId String?   @map("payment_method_id") @db.Uuid
  xenditInvoiceId String    @unique @map("xendit_invoice_id") @db.VarChar(255)
  amount          Int
  // amount in centavos (PHP smallest unit)
  currency        String    @default("PHP") @db.VarChar(3)
  status          String    @default("pending") @db.VarChar(20)
  // status: pending, processing, succeeded, failed, refunded
  paymentType     String    @map("payment_type") @db.VarChar(20)
  // paymentType: subscription, upgrade, one_time
  description     String?
  metadata        Json?     @default("{}")
  paidAt          DateTime? @map("paid_at") @db.Timestamptz
  failedAt        DateTime? @map("failed_at") @db.Timestamptz
  failureReason   String?   @map("failure_reason")
  // Refund tracking — populated from Xendit refund.succeeded webhooks.
  refundedAt      DateTime? @map("refunded_at") @db.Timestamptz
  refundedAmount  Int?      @map("refunded_amount")
  // refundedAmount in centavos (PHP smallest unit), matches `amount`
  refundId        String?   @unique @map("refund_id") @db.VarChar(255)
  refundReason    String?   @map("refund_reason")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription          Subscription?          @relation(fields: [subscriptionId], references: [id])
  paymentMethod         PaymentMethod?         @relation(fields: [paymentMethodId], references: [id])
  invoices              Invoice[]
  migration             SubscriptionMigration?
  couponRedemption      CouponRedemption?
  promotionRedemption   PromotionRedemption?
  checkoutPriceSnapshot CheckoutPriceSnapshot?

  @@index([organizationId], map: "idx_payments_org")
  @@index([status], map: "idx_payments_status")
  @@map("payments")
}

model Invoice {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  subscriptionId     String?   @map("subscription_id") @db.Uuid
  paymentId          String?   @map("payment_id") @db.Uuid
  invoiceNumber      String    @unique @map("invoice_number") @db.VarChar(50)
  amount             Int
  // amount in centavos
  currency           String    @default("PHP") @db.VarChar(3)
  status             String    @default("draft") @db.VarChar(20)
  // status: draft, open, paid, void
  description        String?
  lineItemsJson      Json      @default("[]") @map("line_items_json")
  billingPeriodStart DateTime? @map("billing_period_start") @db.Timestamptz
  billingPeriodEnd   DateTime? @map("billing_period_end") @db.Timestamptz
  dueDate            DateTime? @map("due_date") @db.Timestamptz
  paidAt             DateTime? @map("paid_at") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  payment      Payment?      @relation(fields: [paymentId], references: [id])

  @@index([organizationId], map: "idx_invoices_org")
  @@index([status], map: "idx_invoices_status")
  @@map("invoices")
}

model PendingInvite {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  email          String    @db.VarChar(255)
  role           String    @default("member") @db.VarChar(20)
  tokenHash      String    @unique @map("token_hash") @db.VarChar(128)
  invitedBy      String    @map("invited_by") @db.Uuid
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@index([tokenHash], map: "idx_pending_invites_token")
  @@map("pending_invites")
}

// ==========================================================================
// 5.2 Legal Corpus
// ==========================================================================

model Source {
  id                 String    @id @default(uuid()) @db.Uuid
  name               String    @db.VarChar(255)
  type               String    @db.VarChar(30)
  domain             String?   @db.VarChar(255)
  trustLevel         String    @default("medium") @map("trust_level") @db.VarChar(10)
  enabled            Boolean   @default(true)
  fetchStrategy      String    @default("crawler") @map("fetch_strategy") @db.VarChar(20)
  healthScore        Float?    @map("health_score") @db.Real
  lastHealthCheckAt  DateTime? @map("last_health_check_at") @db.Timestamptz
  healthMetadataJson Json?     @map("health_metadata_json")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  endpoints           SourceEndpoint[]
  legalDocuments      LegalDocument[]
  ingestionJobs       IngestionJob[]
  ingestionCandidates IngestionCandidate[]
  backfillBatches     BackfillBatch[]

  @@map("sources")
}

model SourceEndpoint {
  id              String    @id @default(uuid()) @db.Uuid
  sourceId        String    @map("source_id") @db.Uuid
  endpointUrl     String    @map("endpoint_url")
  contentTypeHint String?   @map("content_type_hint") @db.VarChar(50)
  scheduleCron    String?   @map("schedule_cron") @db.VarChar(100)
  parserType      String    @map("parser_type") @db.VarChar(50)
  lastFetchedAt   DateTime? @map("last_fetched_at") @db.Timestamptz
  lastSuccessAt   DateTime? @map("last_success_at") @db.Timestamptz
  status          String    @default("active") @db.VarChar(20)

  // Relations
  source          Source          @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  ingestionJobs   IngestionJob[]
  backfillBatches BackfillBatch[]

  @@map("source_endpoints")
}

/// Per-source incremental-crawl cursor. Advanced only on successful completion
/// of a daily crawl task so transient fetch failures don't skip decisions.
model CrawlState {
  sourceId      String    @id @map("source_id") @db.Uuid
  lastCrawledAt DateTime? @map("last_crawled_at") @db.Timestamptz
  lastCursor    String?   @map("last_cursor")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("crawl_state")
}

model LegalDocument {
  id                 String    @id @default(uuid()) @db.Uuid
  sourceId           String?   @map("source_id") @db.Uuid
  canonicalUrl       String?   @map("canonical_url")
  externalId         String?   @map("external_id") @db.VarChar(255)
  documentType       String    @map("document_type") @db.VarChar(30)
  jurisdiction       String?   @default("PH") @db.VarChar(50)
  title              String
  shortTitle         String?   @map("short_title") @db.VarChar(500)
  citationText       String?   @map("citation_text") @db.VarChar(500)
  grNo               String?   @map("gr_no") @db.VarChar(100)
  docketNo           String?   @map("docket_no") @db.VarChar(100)
  promulgationDate   DateTime? @map("promulgation_date") @db.Date
  decisionDate       DateTime? @map("decision_date") @db.Date
  publicationDate    DateTime? @map("publication_date") @db.Date
  ponente            String?   @db.VarChar(255)
  court              String?   @db.VarChar(255)
  agency             String?   @db.VarChar(255)
  status             String    @default("draft") @db.VarChar(20)
  language           String?   @default("en") @db.VarChar(10)
  checksum           String?   @db.VarChar(128)
  versionNo          Int       @default(1) @map("version_no")
  isOfficial         Boolean   @default(false) @map("is_official")
  isPublished        Boolean   @default(false) @map("is_published")
  truthfulnessStatus String    @default("needs_review") @map("truthfulness_status") @db.VarChar(20)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  source                   Source?                     @relation(fields: [sourceId], references: [id])
  versions                 LegalDocumentVersion[]
  sections                 LegalDocumentSection[]
  tagMaps                  LegalDocumentTagMap[]
  citationsFrom            Citation[]                  @relation("CitationsFrom")
  citationsTo              Citation[]                  @relation("CitationsTo")
  digests                  Digest[]
  bookmarks                Bookmark[]
  annotations              Annotation[]
  matterDocuments          MatterDocument[]
  editorialFlags           EditorialFlag[]             @relation("DocEditorialFlags")
  provenanceRecords        ProvenanceRecord[]
  flashcards               Flashcard[]
  reviewerPackItems        ReviewerPackItem[]
  doctrineExtracts         DoctrineExtract[]
  similaritiesAsA          DocumentSimilarity[]        @relation("SimilarityDocA")
  similaritiesAsB          DocumentSimilarity[]        @relation("SimilarityDocB")
  caseCodalAsCase          CaseCodalLink[]             @relation("CaseCodalCase")
  caseCodalAsCodal         CaseCodalLink[]             @relation("CaseCodalCodal")
  canonicalSimilarities    DocumentSimilarity[]        @relation("CanonicalDocument")
  matchedCandidates        IngestionCandidate[]        @relation("CandidateMatchedDoc")
  // Derivative artifacts (§2.2)
  derivativeArtifacts      DerivativeArtifact[]
  derivativeGenerationJobs DerivativeGenerationJob[]
  barExamSittings          BarExamSitting[]
  // Subject taxonomy assignments (§5.8c)
  subjectAssignments       DocumentSubjectAssignment[]
  // Golden sets (PR 4.1)
  goldenSetEntries         GoldenSetEntry[]

  @@index([documentType], map: "idx_legal_docs_type")
  @@index([grNo], map: "idx_legal_docs_gr_no")
  @@index([citationText], map: "idx_legal_docs_citation")
  @@index([court, decisionDate], map: "idx_legal_docs_court_date")
  @@index([status, isPublished], map: "idx_legal_docs_status")
  @@map("legal_documents")
}

model LegalDocumentVersion {
  id                      String   @id @default(uuid()) @db.Uuid
  legalDocumentId         String   @map("legal_document_id") @db.Uuid
  rawFileObjectKey        String?  @map("raw_file_object_key")
  normalizedTextObjectKey String?  @map("normalized_text_object_key")
  htmlObjectKey           String?  @map("html_object_key")
  extractedJson           Json?    @map("extracted_json")
  snapshotHash            String   @map("snapshot_hash") @db.VarChar(128)
  parserVersion           String?  @map("parser_version") @db.VarChar(50)
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  legalDocument LegalDocument @relation(fields: [legalDocumentId], references: [id], onDelete: Cascade)

  @@map("legal_document_versions")
}

model LegalDocumentSection {
  id              String   @id @default(uuid()) @db.Uuid
  legalDocumentId String   @map("legal_document_id") @db.Uuid
  parentSectionId String?  @map("parent_section_id") @db.Uuid
  sectionType     String   @map("section_type") @db.VarChar(30)
  sectionLabel    String?  @map("section_label") @db.VarChar(255)
  ordering        Int      @default(0)
  plainText       String?  @map("plain_text")
  htmlText        String?  @map("html_text")
  pageStart       Int?     @map("page_start")
  pageEnd         Int?     @map("page_end")
  tokenCount      Int?     @map("token_count")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  legalDocument       LegalDocument          @relation(fields: [legalDocumentId], references: [id], onDelete: Cascade)
  parentSection       LegalDocumentSection?  @relation("SectionHierarchy", fields: [parentSectionId], references: [id])
  childSections       LegalDocumentSection[] @relation("SectionHierarchy")
  citations           Citation[]
