model SubscriptionMigration {
  id                   String   @id @default(uuid()) @db.Uuid
  organizationId       String   @map("organization_id") @db.Uuid
  fromSubscriptionId   String   @map("from_subscription_id") @db.Uuid
  toSubscriptionId     String   @map("to_subscription_id") @db.Uuid
  fromPlanCode         String   @map("from_plan_code") @db.VarChar(50)
  toPlanCode           String   @map("to_plan_code") @db.VarChar(50)
  direction            String   @db.VarChar(20)
  // direction: upgrade, downgrade
  fromBillingPeriod    String?  @map("from_billing_period") @db.VarChar(20)
  toBillingPeriod      String?  @map("to_billing_period") @db.VarChar(20)
