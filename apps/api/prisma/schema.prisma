  doctrineExtracts    DoctrineExtract[]
  caseCodalLinks      CaseCodalLink[]
  // Derivative artifacts (§2.2)
  derivativeArtifacts DerivativeArtifact[]

  @@index([legalDocumentId], map: "idx_sections_doc_id")
  @@index([sectionType], map: "idx_sections_type")
  @@map("legal_document_sections")
}

model LegalMetadataTag {
  id      String @id @default(uuid()) @db.Uuid
  code    String @unique @db.VarChar(100)
  name    String @db.VarChar(255)
  tagType String @map("tag_type") @db.VarChar(30)

  // Relations
  documentTags LegalDocumentTagMap[]

  @@map("legal_metadata_tags")
}

model LegalDocumentTagMap {
  id              String  @id @default(uuid()) @db.Uuid
  legalDocumentId String  @map("legal_document_id") @db.Uuid
  tagId           String  @map("tag_id") @db.Uuid
  isPrimary       Boolean @default(false) @map("is_primary")
  confidence      Float?  @db.Real
  classifiedBy    String  @default("rule_based") @map("classified_by") @db.VarChar(30)
  reviewStatus    String  @default("auto") @map("review_status") @db.VarChar(20)

  // Relations
  legalDocument LegalDocument    @relation(fields: [legalDocumentId], references: [id], onDelete: Cascade)
  tag           LegalMetadataTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([legalDocumentId, tagId])
  @@index([reviewStatus], map: "idx_tag_map_review_status")
  @@map("legal_document_tag_map")
}

model Citation {
  id                 String    @id @default(uuid()) @db.Uuid
  fromDocumentId     String    @map("from_document_id") @db.Uuid
  fromSectionId      String?   @map("from_section_id") @db.Uuid
  toDocumentId       String?   @map("to_document_id") @db.Uuid
  citationText       String    @map("citation_text")
  citationType       String    @map("citation_type") @db.VarChar(20)
  normalizedCitation String?   @map("normalized_citation") @db.VarChar(500)
  confidence         Float?    @db.Real
  resolvedAt         DateTime? @map("resolved_at") @db.Timestamptz
  resolverMethod     String?   @map("resolver_method") @db.VarChar(50)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  fromDocument LegalDocument         @relation("CitationsFrom", fields: [fromDocumentId], references: [id], onDelete: Cascade)
  fromSection  LegalDocumentSection? @relation(fields: [fromSectionId], references: [id])
  toDocument   LegalDocument?        @relation("CitationsTo", fields: [toDocumentId], references: [id])

  @@index([fromDocumentId], map: "idx_citations_from")
  @@index([toDocumentId], map: "idx_citations_to")
  @@map("citations")
}

model Embedding {
  id              String   @id @default(uuid()) @db.Uuid
  entityType      String   @map("entity_type") @db.VarChar(20)
  entityId        String   @map("entity_id") @db.Uuid
  embeddingModel  String   @map("embedding_model") @db.VarChar(100)
  vectorRef       String   @map("vector_ref")
  sparseVectorRef String?  @map("sparse_vector_ref")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Polymorphic: entityId references either legal_documents.id or
  // legal_document_sections.id, discriminated by entityType. No FK —
  // Postgres can't validate polymorphic refs without triggers/inheritance.
  // Application layer (worker-service db_client.create_embedding) is
  // responsible for verifying the target row exists before insert.

  @@index([entityType, entityId], map: "idx_embeddings_entity")
  @@map("embeddings")
}

// ==========================================================================
// 5.3 Digests & Editorial Outputs
// ==========================================================================

model Digest {
  id                        String   @id @default(uuid()) @db.Uuid
  legalDocumentId           String?  @map("legal_document_id") @db.Uuid
  organizationId            String?  @map("organization_id") @db.Uuid
  userId                    String?  @map("user_id") @db.Uuid
  assignedReviewerUserId    String?  @map("assigned_reviewer_user_id") @db.Uuid
  sourceOrigin              String   @map("source_origin") @db.VarChar(30)
  title                     String
  digestType                String   @map("digest_type") @db.VarChar(30)
  facts                     String?
  issues                    String?
  ruling                    String?
  doctrine                  String?
  dispositive               String?
  summary                   String?
  petitionerArguments       String?  @map("petitioner_arguments")
  respondentArguments       String?  @map("respondent_arguments")
  citedAuthoritiesJson      Json     @default("[]") @map("cited_authorities_json")
  confidenceScore           Float?   @map("confidence_score") @db.Real
  reviewStatus              String   @default("draft") @map("review_status") @db.VarChar(30)
  visibility                String   @default("private") @db.VarChar(20)
  avgRating                 Float?   @map("avg_rating") @db.Real
  ratingCount               Int      @default(0) @map("rating_count")
  voteScore                 Int      @default(0) @map("vote_score")
  // AI generation metadata (PR 3.2)
  modelRunId                String?  @map("model_run_id") @db.Uuid
  promptTemplateVersion     String?  @map("prompt_template_version") @db.VarChar(40)
  validatorVerdict          String?  @map("validator_verdict") @db.VarChar(20)
  validatorReasonsJson      Json?    @map("validator_reasons_json")
  contentDisclaimerId       String?  @map("content_disclaimer_id") @db.Uuid
  derivativeGenerationJobId String?  @map("derivative_generation_job_id") @db.Uuid
  sectionUsageJson          Json?    @map("section_usage_json")
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                 DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  legalDocument           LegalDocument?           @relation(fields: [legalDocumentId], references: [id])
  organization            Organization?            @relation(fields: [organizationId], references: [id])
  user                    User?                    @relation(fields: [userId], references: [id])
  assignedReviewer        User?                    @relation("DigestAssignedReviewer", fields: [assignedReviewerUserId], references: [id])
  modelRun                ModelRun?                @relation(fields: [modelRunId], references: [id])
  contentDisclaimer       ContentDisclaimer?       @relation(fields: [contentDisclaimerId], references: [id])
  derivativeGenerationJob DerivativeGenerationJob? @relation(fields: [derivativeGenerationJobId], references: [id])
  reviews                 DigestReview[]
  doctrineExtracts        DoctrineExtract[]
  editorialFlags          EditorialFlag[]          @relation("DigestEditorialFlags")
  flashcards              Flashcard[]
  reviewerPackItems       ReviewerPackItem[]
  userUploads             UserUpload[]

  @@unique([legalDocumentId, digestType], map: "uq_digest_document_type")
  @@index([legalDocumentId], map: "idx_digests_doc")
  @@index([userId], map: "idx_digests_user")
  @@index([reviewStatus], map: "idx_digests_review")
  @@index([assignedReviewerUserId], map: "idx_digests_reviewer")
  @@index([visibility, avgRating(sort: Desc)], map: "idx_digests_marketplace")
  @@index([visibility, voteScore(sort: Desc)], map: "idx_digests_vote_score")
  @@map("digests")
}

model DigestReview {
  id                    String   @id @default(uuid()) @db.Uuid
  digestId              String   @map("digest_id") @db.Uuid
  reviewerUserId        String   @map("reviewer_user_id") @db.Uuid
  verdict               String   @db.VarChar(10)
  notes                 String?
  truthfulnessScore     Float?   @map("truthfulness_score") @db.Real
  completenessScore     Float?   @map("completeness_score") @db.Real
  citationAccuracyScore Float?   @map("citation_accuracy_score") @db.Real
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  digest   Digest @relation(fields: [digestId], references: [id], onDelete: Cascade)
  reviewer User   @relation(fields: [reviewerUserId], references: [id])

  @@map("digest_reviews")
}

model DerivativeReview {
  id                    String   @id @default(uuid()) @db.Uuid
  derivativeArtifactId  String   @map("derivative_artifact_id") @db.Uuid
  reviewerUserId        String   @map("reviewer_user_id") @db.Uuid
  verdict               String   @db.VarChar(20)
  notes                 String?
  truthfulnessScore     Float?   @map("truthfulness_score") @db.Real
  completenessScore     Float?   @map("completeness_score") @db.Real
  citationAccuracyScore Float?   @map("citation_accuracy_score") @db.Real
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  derivativeArtifact DerivativeArtifact @relation(fields: [derivativeArtifactId], references: [id], onDelete: Cascade)
  reviewer           User               @relation(fields: [reviewerUserId], references: [id])

  @@index([derivativeArtifactId])
  @@index([reviewerUserId, createdAt(sort: Desc)])
  @@map("derivative_reviews")
}

model DoctrineExtract {
  id              String   @id @default(uuid()) @db.Uuid
  legalDocumentId String?  @map("legal_document_id") @db.Uuid
  digestId        String?  @map("digest_id") @db.Uuid
  text            String
  normalizedText  String?  @map("normalized_text")
  doctrineType    String?  @map("doctrine_type") @db.VarChar(50)
  sourceSectionId String?  @map("source_section_id") @db.Uuid
  confidence      Float?   @db.Real
  reviewStatus    String   @default("draft") @map("review_status") @db.VarChar(20)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  legalDocument LegalDocument?        @relation(fields: [legalDocumentId], references: [id])
  digest        Digest?               @relation(fields: [digestId], references: [id])
  sourceSection LegalDocumentSection? @relation(fields: [sourceSectionId], references: [id])
  linksFrom     DoctrineLink[]        @relation("DoctrineLinksFrom")
  linksTo       DoctrineLink[]        @relation("DoctrineLinksTo")

  @@index([legalDocumentId], map: "idx_doctrine_extracts_doc")
  @@index([doctrineType], map: "idx_doctrine_extracts_type")
  @@index([reviewStatus], map: "idx_doctrine_extracts_review")
  @@map("doctrine_extracts")
}

model DoctrineLink {
  id             String   @id @default(uuid()) @db.Uuid
  fromDoctrineId String   @map("from_doctrine_id") @db.Uuid
  toDoctrineId   String   @map("to_doctrine_id") @db.Uuid
  linkType       String   @map("link_type") @db.VarChar(30)
  confidence     Float?   @db.Real
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  fromDoctrine DoctrineExtract @relation("DoctrineLinksFrom", fields: [fromDoctrineId], references: [id], onDelete: Cascade)
  toDoctrine   DoctrineExtract @relation("DoctrineLinksTo", fields: [toDoctrineId], references: [id], onDelete: Cascade)

  @@index([fromDoctrineId], map: "idx_doctrine_links_from")
  @@index([toDoctrineId], map: "idx_doctrine_links_to")
  @@map("doctrine_links")
}

model DocumentSimilarity {
  id                         String    @id @default(uuid()) @db.Uuid
  documentAId                String    @map("document_a_id") @db.Uuid
  documentBId                String    @map("document_b_id") @db.Uuid
  similarityScore            Float     @map("similarity_score") @db.Real
  similarityType             String    @map("similarity_type") @db.VarChar(30)
  status                     String    @default("pending") @db.VarChar(20)
  classificationTier         String?   @map("classification_tier") @db.VarChar(30)
  classificationConfidence   Float?    @map("classification_confidence") @db.Real
  classificationMetadataJson Json?     @map("classification_metadata_json")
  canonicalDocumentId        String?   @map("canonical_document_id") @db.Uuid
  reviewedByUserId           String?   @map("reviewed_by_user_id") @db.Uuid
  reviewedAt                 DateTime? @map("reviewed_at") @db.Timestamptz
  createdAt                  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  documentA         LegalDocument  @relation("SimilarityDocA", fields: [documentAId], references: [id], onDelete: Cascade)
  documentB         LegalDocument  @relation("SimilarityDocB", fields: [documentBId], references: [id], onDelete: Cascade)
  canonicalDocument LegalDocument? @relation("CanonicalDocument", fields: [canonicalDocumentId], references: [id])
  reviewedByUser    User?          @relation("SimilarityReviewer", fields: [reviewedByUserId], references: [id])

  @@index([documentAId], map: "idx_doc_similarity_a")
  @@index([documentBId], map: "idx_doc_similarity_b")
  @@index([status], map: "idx_doc_similarity_status")
  @@index([classificationTier], map: "idx_doc_similarity_tier")
  @@map("document_similarities")
}

model CaseCodalLink {
  id              String   @id @default(uuid()) @db.Uuid
  caseDocumentId  String   @map("case_document_id") @db.Uuid
  codalDocumentId String   @map("codal_document_id") @db.Uuid
  codalSectionId  String?  @map("codal_section_id") @db.Uuid
  linkType        String   @map("link_type") @db.VarChar(30)
  // linkType: interprets, applies, invalidates, modifies, upholds, cites
  notes           String?
  confidence      Float?   @db.Real
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  caseDocument  LegalDocument         @relation("CaseCodalCase", fields: [caseDocumentId], references: [id], onDelete: Cascade)
  codalDocument LegalDocument         @relation("CaseCodalCodal", fields: [codalDocumentId], references: [id], onDelete: Cascade)
  codalSection  LegalDocumentSection? @relation(fields: [codalSectionId], references: [id])
  createdBy     User                  @relation(fields: [createdByUserId], references: [id])

  @@index([caseDocumentId], map: "idx_case_codal_case")
  @@index([codalDocumentId], map: "idx_case_codal_codal")
  @@index([codalSectionId], map: "idx_case_codal_section")
  @@map("case_codal_links")
}

