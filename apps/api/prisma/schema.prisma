// ==========================================================================
// Content Disclaimers (§8.2 / §8.6 of corpus-platform target architecture)
//
// Single source of truth for disclaimer text attached to every
// AI-generated derivative artifact before it leaves the API. The
// AttachDisclaimerInterceptor reads rows from this table via
// ContentDisclaimersService and splices them into derivative responses.
//
// Versioning: one active row per contentClass. Updates bump `version`
// and rewrite the row in place. Per-artifact version pinning (for
// frozen display on historical derivatives) is a follow-up.
// ==========================================================================

model ContentDisclaimer {
  id           String   @id @default(uuid()) @db.Uuid
  contentClass String   @unique @map("content_class") @db.VarChar(100)
  bodyHtml     String   @map("body_html") @db.Text
  bodyPlain    String   @map("body_plain") @db.Text
  version      Int      @default(1)
  isActive     Boolean  @default(true) @map("is_active")
  authorNote   String?  @map("author_note") @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Back-reference for the non-null FK on DerivativeArtifact (§2.2, §2.5).
  // Every derivative must attach a disclaimer — enforced at the DB level.
  derivativeArtifacts DerivativeArtifact[]
  // Digests (PR 3.2) — optional disclaimer attachment for AI-generated digests
  digests             Digest[]

  @@map("content_disclaimers")
}

// ==========================================================================
// 5.X Derivative Artifacts (§2.2)
//
// Parent table for all AI-generated derivative content (case digests,
// doctrine extracts, MCQs, essay prompts, outlines, flashcards, sample
// pleadings, sample contracts, ...). Per-type child tables (McqQuestion,
// EssayPrompt, DocumentSubjectAssignment, ...) land with their respective
// per-type PRs; the back-reference fields are deliberately omitted here
// to keep this migration foundation-only.
//
// Invariant (§4.5): a DerivativeArtifact row is never written without at
// least one ProvenanceRecord row in the same transaction. The service
// layer (DerivativeArtifactService.create) enforces this — there is no
// DB-level CHECK constraint by design.
// ==========================================================================

model DerivativeArtifact {
  id                        String  @id @default(uuid()) @db.Uuid
  derivativeType            String  @map("derivative_type") @db.VarChar(40)
  //   case_digest | doctrine_extract | mcq_question | essay_prompt | essay_model_answer
  //   | suggested_bar_answer | flashcard | subject_outline | sample_pleading
  //   | sample_contract | one_page_summary
  sourceDocumentId          String? @map("source_document_id") @db.Uuid
  sourceSectionId           String? @map("source_section_id") @db.Uuid
  organizationId            String? @map("organization_id") @db.Uuid
  createdByUserId           String? @map("created_by_user_id") @db.Uuid
  derivativeGenerationJobId String? @map("derivative_generation_job_id") @db.Uuid

  title            String  @db.Text
  contentJson      Json    @map("content_json")
  contentPlainText String? @map("content_plain_text") @db.Text
  contentHash      String  @map("content_hash") @db.VarChar(128)
  tokenCount       Int?    @map("token_count")

  confidenceScore      Float?  @map("confidence_score") @db.Real
  reviewStatus         String  @default("draft") @map("review_status") @db.VarChar(20)
  //   draft | needs_human_review | approved | rejected
  validatorVerdict     String? @map("validator_verdict") @db.VarChar(20)
  validatorReasonsJson Json?   @map("validator_reasons_json")
  visibility           String  @default("private") @db.VarChar(20)
  //   private | public_editorial | unlisted

  audience String @default("both") @db.VarChar(20)
  //   student | practitioner | both

  contentRights       String @map("content_rights") @db.VarChar(40)
  //   public_domain_government | ai_generated_derivative | mixed
  contentDisclaimerId String @map("content_disclaimer_id") @db.Uuid

  modelRunId      String? @map("model_run_id") @db.Uuid
  taxonomyVersion String? @map("taxonomy_version") @db.VarChar(20)
  //   study_8 | bar_admin_6 — populated by the subject classifier (later PR)
  language        String  @default("en") @db.VarChar(10)

  publishedAt DateTime? @map("published_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  sourceDocument          LegalDocument?           @relation(fields: [sourceDocumentId], references: [id])
  sourceSection           LegalDocumentSection?    @relation(fields: [sourceSectionId], references: [id])
  organization            Organization?            @relation(fields: [organizationId], references: [id])
  createdByUser           User?                    @relation("DerivativeCreatedBy", fields: [createdByUserId], references: [id])
  derivativeGenerationJob DerivativeGenerationJob? @relation(fields: [derivativeGenerationJobId], references: [id])
  modelRun                ModelRun?                @relation(fields: [modelRunId], references: [id])
  contentDisclaimer       ContentDisclaimer        @relation(fields: [contentDisclaimerId], references: [id])

  // MCQ child table (§2.2). `mcqQuestion` is non-null-ish in practice for
  // artifacts whose derivativeType is 'mcq_question', but Prisma models
  // the relation as optional because the base row itself does not know
  // which type-specific child exists until the transactional write
  // finishes. Service-layer `createMcqQuestion` is the only writer.
  mcqQuestion McqQuestion?

  // EssayPrompt child table (§2.2). Same one-to-one pattern as mcqQuestion.
  essayPrompt EssayPrompt?

  // Subject taxonomy assignments (§5.8c)
  subjectAssignments DocumentSubjectAssignment[]

  // Admin review history (mirrors Digest.reviews)
  reviews DerivativeReview[]

  // Deferred relations — child tables land with their own PRs:
  //   - Digest.derivativeArtifactId dual-write: case_digest dual-write PR

  @@unique([sourceDocumentId, derivativeType, taxonomyVersion])
  @@index([derivativeType, reviewStatus])
  @@index([sourceDocumentId, derivativeType])
  @@index([organizationId, derivativeType])
  @@index([visibility, derivativeType, publishedAt])
  @@index([deletedAt])
  // ^ One artifact per (source, type, taxonomy). PostgreSQL treats NULL as
  //   distinct in unique constraints, so uniqueness only actually bites
  //   when all three columns are non-null — acceptable for Phase 1 because
  //   taxonomyVersion is only populated by the classifier in a later PR.
  @@map("derivative_artifacts")
}

model DerivativeGenerationJob {
  id                    String    @id @default(uuid()) @db.Uuid
  derivativeType        String    @map("derivative_type") @db.VarChar(40)
  triggerType           String    @map("trigger_type") @db.VarChar(20)
  //   scheduled | manual | backfill_followup
  sourceDocumentId      String?   @map("source_document_id") @db.Uuid
  // Subject-level dispatch key for `subject_outline` jobs. Outline generation
  // synthesises across multiple documents classified under the same primary
  // subject, so these rows carry `sourceDocumentId = NULL` and
  // `subjectCode = <subjects.code>` instead. All other derivative types
  // continue to use `sourceDocumentId`.
  subjectCode           String?   @map("subject_code") @db.VarChar(50)
  backfillBatchId       String?   @map("backfill_batch_id") @db.Uuid
  // ^ No `backfillBatch` relation yet — the BackfillBatch model lands with
  //   the backfill-engine PR. The column is added here so that PR can
  //   attach the relation without rewriting existing rows.
  status                String    @default("pending") @db.VarChar(20)
  //   pending | running | validating | completed | failed | skipped_budget
  promptTemplateVersion String?   @map("prompt_template_version") @db.VarChar(40)
  modelName             String?   @map("model_name") @db.VarChar(100)
  tokensIn              Int       @default(0) @map("tokens_in")
  tokensOut             Int       @default(0) @map("tokens_out")
  estimatedCostUsd      Decimal   @default(0) @map("estimated_cost_usd") @db.Decimal(10, 6)
  startedAt             DateTime? @map("started_at") @db.Timestamptz
  finishedAt            DateTime? @map("finished_at") @db.Timestamptz
  errorJson             Json?     @map("error_json")
  triggeredByUserId     String?   @map("triggered_by_user_id") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  sourceDocument      LegalDocument?       @relation(fields: [sourceDocumentId], references: [id])
  triggeredByUser     User?                @relation("DerivativeJobTriggeredBy", fields: [triggeredByUserId], references: [id])
  derivativeArtifacts DerivativeArtifact[]
  digests             Digest[]

  @@index([derivativeType, status])
  @@index([backfillBatchId])
  @@index([sourceDocumentId, derivativeType])
  @@index([derivativeType, subjectCode])
  @@map("derivative_generation_jobs")
}

// ---------------------------------------------------------------------------
// MCQ child tables (§2.2)
//
// Every MCQ is a `DerivativeArtifact` row with `derivativeType = 'mcq_question'`
// plus one `mcq_questions` row (query-side metadata for subject/topic and
// difficulty filtering) plus exactly four `mcq_options` rows (A, B, C, D).
//
// The §5.3 output schema is ALSO mirrored into `derivativeArtifact.contentJson`
// so surfaces that already consume the base row don't need a child-table join
// to render the question. The child tables are the source of truth for
// structured queries (join on subject topic, filter by difficulty, aggregate
// answer correctness over McqAttempt once that table lands).
//
// The §5.3 content-quality checks (distractor plausibility, stem doesn't
// leak the answer, supporting section IDs exist, subject-coherence) live in
// the `McqQuestionValidator` (§4.4) — NOT in this schema and NOT in the
// service write path. This PR only enforces the five structural invariants
// (four options, one correct, labels A/B/C/D, stem present, explanation
// present) because those are the invariants that make the rows themselves
// coherent on disk. Content rules run upstream, in the generation pipeline.
// ---------------------------------------------------------------------------

model McqQuestion {
  id                   String  @id @default(uuid()) @db.Uuid
  derivativeArtifactId String  @unique @map("derivative_artifact_id") @db.Uuid
  questionStem         String  @map("question_stem") @db.Text
  explanation          String? @db.Text
  difficulty           String  @default("medium") @db.VarChar(10)
  //   easy | medium | hard | bar_exam_level
  questionFormat       String  @default("single_best") @map("question_format") @db.VarChar(20)
  //   single_best | multi_select | true_false
  subjectTopicId       String? @map("subject_topic_id") @db.Uuid

  derivativeArtifact DerivativeArtifact @relation(fields: [derivativeArtifactId], references: [id], onDelete: Cascade)
  subjectTopic       SubjectTopic?      @relation(fields: [subjectTopicId], references: [id])
  options            McqOption[]

  @@index([subjectTopicId, difficulty])
  @@map("mcq_questions")
}

model McqOption {
  id            String  @id @default(uuid()) @db.Uuid
  mcqQuestionId String  @map("mcq_question_id") @db.Uuid
  optionLabel   String  @map("option_label") @db.VarChar(4)
  //   "A" | "B" | "C" | "D" — uniqueness enforced via @@unique below
  optionText    String  @map("option_text") @db.Text
  isCorrect     Boolean @default(false) @map("is_correct")
  rationale     String? @db.Text
  //   Why this option is right/wrong. Populated by the generator; validator
  //   checks that the correct option's rationale cites a source section.

  mcqQuestion McqQuestion @relation(fields: [mcqQuestionId], references: [id], onDelete: Cascade)

  @@unique([mcqQuestionId, optionLabel])
  @@map("mcq_options")
}

// ---------------------------------------------------------------------------
// Bar Exam Sitting (§2.2)
//
// Reference table for a specific bar examination administration: a particular
// year, part (e.g., "Day 1 AM", "remedial-I"), and subject. Links essay
// prompts to historical bar exam metadata and optionally to a source
// LegalDocument (the exam paper itself, if ingested into the corpus).
//
// @@unique([year, part, subjectStudyCode]) prevents duplicates for the same
// sitting/subject combination. Taxonomy codes use the study_8 and
// bar_admin_6 classification systems defined in the architecture doc.
// ---------------------------------------------------------------------------

model BarExamSitting {
  id                  String  @id @default(uuid()) @db.Uuid
  year                Int
  part                String? @db.VarChar(20)
  subjectStudyCode    String? @map("subject_study_code") @db.VarChar(40)
  subjectBarAdminCode String? @map("subject_bar_admin_code") @db.VarChar(40)
  chairperson         String? @db.VarChar(255)
  sourceDocumentId    String? @map("source_document_id") @db.Uuid
  sourceUrl           String? @map("source_url") @db.Text
  taxonomyVersion     String  @map("taxonomy_version") @db.VarChar(20)

  sourceDocument LegalDocument?    @relation(fields: [sourceDocumentId], references: [id])
  essayPrompts   EssayPrompt[]
  questions      BarExamQuestion[]

  @@unique([year, part, subjectStudyCode])
  @@index([year])
  @@map("bar_exam_sittings")
}

// ---------------------------------------------------------------------------
// BarExamQuestion — verbatim past bar exam question texts from official
// archives (currently LawPhil 2006-2022).
//
// Read-only display content. Sub-parts (a)/(b)/(c) within a question stay
// inline in `question_text` (verbatim) and are counted in `sub_parts_count`.
// One row per primary numbered question; sittings own their question set
// via `bar_exam_sitting_id` with cascade delete.
// ---------------------------------------------------------------------------

model BarExamQuestion {
  id                  String   @id @default(uuid()) @db.Uuid
  barExamSittingId    String   @map("bar_exam_sitting_id") @db.Uuid
  questionNumber      Int      @map("question_number") @db.SmallInt
  questionText        String   @map("question_text") @db.Text
  subPartsCount       Int      @default(0) @map("sub_parts_count") @db.SmallInt
  sourceUrl           String?  @map("source_url") @db.Text
  sourceSectionAnchor String?  @map("source_section_anchor") @db.Text
  parsedAt            DateTime @map("parsed_at") @db.Timestamptz
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  barExamSitting BarExamSitting  @relation(fields: [barExamSittingId], references: [id], onDelete: Cascade)
  answers        BarExamAnswer[]

  @@unique([barExamSittingId, questionNumber])
  @@index([barExamSittingId])
  @@index([questionNumber])
  @@map("bar_exam_questions")
}

// ---------------------------------------------------------------------------
// BarExamAnswer (Phase 3a) — AI-generated ALAC answers for past bar exam
// questions, pending admin review before they become public.
//
// Phase 3a: only `answer_type = 'ai_generated'` is written. Phase 3b will
// surface approved answers in a public route. Future types ('editorial',
// 'community') reuse the same table.
//
// The unique (bar_exam_question_id, answer_type) constraint guarantees one
// AI answer per question — the worker task is idempotent on this. New
// generations require deleting the prior row first.
// ---------------------------------------------------------------------------

model BarExamAnswer {
  id                   String    @id @default(uuid()) @db.Uuid
  barExamQuestionId    String    @map("bar_exam_question_id") @db.Uuid
  answerType           String    @default("ai_generated") @map("answer_type") @db.VarChar(20)
  answerText           String    @map("answer_text") @db.Text
  structuredAnswerJson Json?     @map("structured_answer_json")
  modelRunId           String?   @map("model_run_id") @db.Uuid
  confidence           Float?    @db.Real
  reviewStatus         String    @default("pending") @map("review_status") @db.VarChar(20)
  visibility           String    @default("private") @map("visibility") @db.VarChar(20)
  reviewedByUserId     String?   @map("reviewed_by_user_id") @db.Uuid
  reviewedAt           DateTime? @map("reviewed_at") @db.Timestamptz
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  question BarExamQuestion @relation(fields: [barExamQuestionId], references: [id], onDelete: Cascade)
  modelRun ModelRun?       @relation(fields: [modelRunId], references: [id])
  reviewer User?           @relation("BarExamAnswerReviewer", fields: [reviewedByUserId], references: [id])

  @@unique([barExamQuestionId, answerType])
  @@index([reviewStatus, createdAt])
  @@map("bar_exam_answers")
}

// ---------------------------------------------------------------------------
// EssayPrompt child table (§2.2)
//
// Every essay prompt is a `DerivativeArtifact` row with
// `derivativeType = 'essay_prompt'` plus one `essay_prompts` row holding
// the structured/queryable fields (prompt text, model answer, rubric,
// optional bar exam sitting link).
//
// The §5.4 output schema is ALSO mirrored into `derivativeArtifact.contentJson`
// so surfaces that already consume the base row don't need a child-table join
// to render the prompt. The child table is the source of truth for structured
// queries (filter by bar exam sitting, time limit, subject topic).
// ---------------------------------------------------------------------------

model EssayPrompt {
  id                   String  @id @default(uuid()) @db.Uuid
  derivativeArtifactId String  @unique @map("derivative_artifact_id") @db.Uuid
  promptText           String  @map("prompt_text") @db.Text
  suggestedTimeMinutes Int?    @map("suggested_time_minutes")
  modelAnswerJson      Json?   @map("model_answer_json")
  rubricJson           Json?   @map("rubric_json")
  subjectTopicId       String? @map("subject_topic_id") @db.Uuid
  barExamSittingId     String? @map("bar_exam_sitting_id") @db.Uuid

  derivativeArtifact DerivativeArtifact @relation(fields: [derivativeArtifactId], references: [id], onDelete: Cascade)
  subjectTopic       SubjectTopic?      @relation(fields: [subjectTopicId], references: [id])
  barExamSitting     BarExamSitting?    @relation(fields: [barExamSittingId], references: [id])

  @@index([subjectTopicId])
  @@index([barExamSittingId])
  @@map("essay_prompts")
}

// ---------------------------------------------------------------------------
// §5.8c Subject Taxonomy
//
// Two coexisting taxonomy systems:
//   - study_8:     8-subject bar review study taxonomy (primary for study mode)
//   - bar_admin_6: 6-subject SC administrative grouping (secondary overlay)
//
// SubjectEquivalence bridges the two taxonomies so bar-admin-facing surfaces
// can resolve back to the granular study_8 subjects used for document
// classification and quiz generation.
//
// DocumentSubjectAssignment is the many-to-many join between documents
// (LegalDocument or DerivativeArtifact) and subjects/topics, supporting
// both AI-classified and manually overridden assignments.
// ---------------------------------------------------------------------------

model Subject {
  id              String   @id @default(uuid()) @db.Uuid
  code            String   @db.VarChar(40)
  name            String   @db.VarChar(200)
  taxonomyVersion String   @map("taxonomy_version") @db.VarChar(20)
  weightPercent   Float?   @map("weight_percent")
  effectiveFrom   Int?     @map("effective_from")
  effectiveTo     Int?     @map("effective_to")
  displayOrder    Int      @default(0) @map("display_order")
  description     String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  topics                 SubjectTopic[]
  documentAssignments    DocumentSubjectAssignment[]
  equivalencesAsBarAdmin SubjectEquivalence[]        @relation("EquivalenceBarAdmin")
  equivalencesAsStudy    SubjectEquivalence[]        @relation("EquivalenceStudy")

  @@unique([code, taxonomyVersion])
  @@index([taxonomyVersion])
  @@map("subjects")
}

model SubjectTopic {
  id           String  @id @default(uuid()) @db.Uuid
  subjectId    String  @map("subject_id") @db.Uuid
  parentId     String? @map("parent_id") @db.Uuid
  code         String  @db.VarChar(80)
  name         String  @db.VarChar(255)
  description  String? @db.Text
  displayOrder Int     @default(0) @map("display_order")

  subject             Subject                     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  parent              SubjectTopic?               @relation("TopicHierarchy", fields: [parentId], references: [id])
  children            SubjectTopic[]              @relation("TopicHierarchy")
  documentAssignments DocumentSubjectAssignment[]
  mcqQuestions        McqQuestion[]
  essayPrompts        EssayPrompt[]

  @@unique([subjectId, code])
  @@index([subjectId, parentId, displayOrder])
  @@map("subject_topics")
}

model SubjectEquivalence {
  id                String  @id @default(uuid()) @db.Uuid
  studySubjectId    String  @map("study_subject_id") @db.Uuid
  barAdminSubjectId String  @map("bar_admin_subject_id") @db.Uuid
  relationship      String  @db.VarChar(20)
  notes             String? @db.Text

  studySubject    Subject @relation("EquivalenceStudy", fields: [studySubjectId], references: [id])
  barAdminSubject Subject @relation("EquivalenceBarAdmin", fields: [barAdminSubjectId], references: [id])

  @@unique([studySubjectId, barAdminSubjectId])
  @@map("subject_equivalences")
}

model DocumentSubjectAssignment {
  id                   String   @id @default(uuid()) @db.Uuid
  legalDocumentId      String?  @map("legal_document_id") @db.Uuid
  derivativeArtifactId String?  @map("derivative_artifact_id") @db.Uuid
  subjectId            String   @map("subject_id") @db.Uuid
  subjectTopicId       String?  @map("subject_topic_id") @db.Uuid
  isPrimary            Boolean  @default(false) @map("is_primary")
  confidence           Float?
  classifiedBy         String   @default("ai") @map("classified_by") @db.VarChar(20)
  classifierModelRunId String?  @map("classifier_model_run_id") @db.Uuid
  manualOverride       Boolean  @default(false) @map("manual_override")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz

  legalDocument      LegalDocument?      @relation(fields: [legalDocumentId], references: [id], onDelete: Cascade)
  derivativeArtifact DerivativeArtifact? @relation(fields: [derivativeArtifactId], references: [id], onDelete: Cascade)
  subject            Subject             @relation(fields: [subjectId], references: [id])
  subjectTopic       SubjectTopic?       @relation(fields: [subjectTopicId], references: [id])
  classifierModelRun ModelRun?           @relation(fields: [classifierModelRunId], references: [id])

  @@unique([legalDocumentId, subjectId, subjectTopicId])
  @@unique([derivativeArtifactId, subjectId, subjectTopicId])
  @@index([subjectId, isPrimary])
  @@index([subjectTopicId])
  @@map("document_subject_assignments")
}

// ==========================================================================
// Backfill Orchestration
// ==========================================================================

model BackfillBatch {
  id                   String    @id @default(uuid()) @db.Uuid
  sourceId             String    @map("source_id") @db.Uuid
  sourceEndpointId     String?   @map("source_endpoint_id") @db.Uuid
  name                 String    @db.VarChar(255)
  description          String?   @db.Text
  yearStart            Int       @map("year_start")
  yearEnd              Int       @map("year_end")
  monthStart           Int?      @map("month_start")
  monthEnd             Int?      @map("month_end")
  status               String    @default("pending") @db.VarChar(20)
  // pending | enumerating | running | paused | halted_budget | halted_admin | completed | failed
  budgetCeilingUsd     Decimal   @map("budget_ceiling_usd") @db.Decimal(10, 4)
  budgetConsumedUsd    Decimal   @default(0) @map("budget_consumed_usd") @db.Decimal(10, 4)
  candidatesDiscovered Int       @default(0) @map("candidates_discovered")
  candidatesProcessed  Int       @default(0) @map("candidates_processed")
  candidatesSkipped    Int       @default(0) @map("candidates_skipped")
  candidatesFailed     Int       @default(0) @map("candidates_failed")
  documentsCreated     Int       @default(0) @map("documents_created")
  documentsUpdated     Int       @default(0) @map("documents_updated")
  // Per-batch concurrency ceiling on dispatched ``process_ingestion_candidate``
  // jobs. Default 25 = the napkin-math sweet spot for LawPhil at ~1 req/sec
  // with ~12s median per-doc latency (parse + S3 + embed) — small enough to
  // stay well under the source's rate-limit threshold but large enough to
  // finish a 9930-candidate decade batch in a couple of days instead of
  // ~60h. Operators can bump per batch via PATCH /admin/backfill/batches/:id/inflight.
  inflightCap          Int       @default(25) @map("inflight_cap")
  checkpointState      Json      @default("{}") @map("checkpoint_state")
  startedAt            DateTime? @map("started_at") @db.Timestamptz
  finishedAt           DateTime? @map("finished_at") @db.Timestamptz
  lastTickAt           DateTime? @map("last_tick_at") @db.Timestamptz
  adminNotes           String?   @map("admin_notes") @db.Text
  createdByUserId      String    @map("created_by_user_id") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  source         Source               @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceEndpoint SourceEndpoint?      @relation(fields: [sourceEndpointId], references: [id])
  createdByUser  User                 @relation("BackfillBatchCreatedBy", fields: [createdByUserId], references: [id])
  ingestionJobs  IngestionJob[]
  checkpoints    BackfillCheckpoint[]

  @@index([sourceId, status])
  @@index([status, lastTickAt])
  @@map("backfill_batches")
}

model BackfillCheckpoint {
  id              String   @id @default(uuid()) @db.Uuid
  backfillBatchId String   @map("backfill_batch_id") @db.Uuid
  cursorJson      Json     @map("cursor_json")
  candidatesSeen  Int      @default(0) @map("candidates_seen")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  backfillBatch BackfillBatch @relation(fields: [backfillBatchId], references: [id], onDelete: Cascade)

  @@index([backfillBatchId, createdAt])
  @@map("backfill_checkpoints")
}

/// Append-only spend history for LLM budget tracking (§7.2).
/// Each row records one cost event (per model run or batch aggregate).
model BudgetLedger {
  id              String   @id @default(uuid()) @db.Uuid
  periodYearMonth String   @map("period_year_month") @db.VarChar(7)
  periodDay       String?  @map("period_day") @db.VarChar(10)
  scope           String   @db.VarChar(80)
  amountUsd       Decimal  @map("amount_usd") @db.Decimal(10, 6)
  tokensIn        Int      @default(0) @map("tokens_in")
  tokensOut       Int      @default(0) @map("tokens_out")
  requestCount    Int      @default(1) @map("request_count")
  modelName       String?  @map("model_name") @db.VarChar(100)
  modelRunId      String?  @map("model_run_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  modelRun ModelRun? @relation(fields: [modelRunId], references: [id])

  @@index([periodYearMonth, scope])
  @@index([periodDay, scope])
  @@index([scope, createdAt])
  @@map("budget_ledger")
}

// ==========================================================================
// Golden Sets & Evaluation (PR 4.1)
//
// AI-drafted golden set entries stored in the database for evaluation.
// Three types: case_digest, subject_classification, mcq_question.
// Admin reviews/approves each entry before it becomes evaluation baseline.
// ==========================================================================

model GoldenSetEntry {
  id                String    @id @default(uuid()) @db.Uuid
  goldenSetType     String    @map("golden_set_type") @db.VarChar(30)
  sourceDocumentId  String?   @map("source_document_id") @db.Uuid
  referenceDataJson Json      @map("reference_data_json")
  status            String    @default("draft") @db.VarChar(20)
  reviewNotes       String?   @map("review_notes") @db.Text
  reviewedByUserId  String?   @map("reviewed_by_user_id") @db.Uuid
  reviewedAt        DateTime? @map("reviewed_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  sourceDocument LegalDocument? @relation(fields: [sourceDocumentId], references: [id])
  reviewedByUser User?          @relation("GoldenSetReviewer", fields: [reviewedByUserId], references: [id])

  @@index([goldenSetType, status])
  @@index([sourceDocumentId])
  @@map("golden_set_entries")
}

model EvaluationRun {
  id                    String    @id @default(uuid()) @db.Uuid
  goldenSetType         String    @map("golden_set_type") @db.VarChar(30)
  promptTemplateVersion String    @map("prompt_template_version") @db.VarChar(40)
  modelName             String    @map("model_name") @db.VarChar(100)
  totalEntries          Int       @map("total_entries")
  passingEntries        Int       @map("passing_entries")
  passRate              Float     @map("pass_rate") @db.Real
  scoreDetailsJson      Json      @map("score_details_json")
  status                String    @default("running") @db.VarChar(20)
  startedAt             DateTime  @default(now()) @map("started_at") @db.Timestamptz
  finishedAt            DateTime? @map("finished_at") @db.Timestamptz
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([goldenSetType, promptTemplateVersion])
  @@map("evaluation_runs")
}

// ==========================================================================
// Audio Corpus — Phase 1 Foundation (text-to-speech renditions)
//
// One row per synthesized audio rendition of a short legal content item
// (a digest or a bar-exam answer) for a given language + voice. Audio + speech
// marks are stored in object storage (MinIO/S3); only the keys live here.
// contentHash is the sha256 of the normalized SSML input, so a content edit
// produces a new hash and a cache miss without colliding on the unique tuple.
// ==========================================================================

model AudioRendition {
  id             String   @id @default(uuid()) @db.Uuid
  contentType    String   @map("content_type") @db.VarChar(30) // 'digest' | 'bar_exam_answer'
  contentId      String   @map("content_id") @db.VarChar(255)
  contentHash    String   @map("content_hash") @db.VarChar(64) // sha256 of normalized SSML input
  language       String   @default("en") @db.VarChar(10)
  voiceId        String   @map("voice_id") @db.VarChar(50)
  engine         String   @default("polly") @db.VarChar(30)
  audioObjectKey String   @map("audio_object_key") @db.VarChar(500)
  marksObjectKey String?  @map("marks_object_key") @db.VarChar(500)
  readalongObjectKey String? @map("readalong_object_key") @db.VarChar(500) // segment read-along manifest JSON (S3 key)
  durationMs     Int?     @map("duration_ms")
  charCount      Int?     @map("char_count")
  status         String   @default("pending") @db.VarChar(20)
  visibility     String   @default("public_editorial") @db.VarChar(30)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([contentType, contentId, language, voiceId])
  @@index([contentHash])
  @@map("audio_renditions")
}
