// ==========================================================================

model LegalMemo {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  matterId         String?  @map("matter_id") @db.Uuid
  query            String
  memoType         String   @map("memo_type") @db.VarChar(30)
  // memoType: legal_opinion, case_analysis, statutory_analysis, comparative, research_summary
  structuredOutput Json?    @map("structured_output")
  citationsJson    Json     @default("[]") @map("citations_json")
  status           String   @default("pending") @db.VarChar(20)
  // status: pending, generating, completed, failed
  confidenceScore  Float?   @map("confidence_score") @db.Real
  modelRunId       String?  @map("model_run_id") @db.Uuid
  jobId            String?  @map("job_id") @db.VarChar(100)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])
  matter       Matter?      @relation(fields: [matterId], references: [id])

  @@index([organizationId], map: "idx_legal_memos_org")
  @@index([userId], map: "idx_legal_memos_user")
  @@index([status], map: "idx_legal_memos_status")
  @@map("legal_memos")
}

model PleadingTemplate {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(255)
  slug         String   @unique @db.VarChar(100)
  category     String   @db.VarChar(50)
  // category: motion, complaint, petition, answer, memorandum, appeal, other
  court        String?  @db.VarChar(255)
  description  String?
  templateJson Json     @map("template_json")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  pleadings Pleading[]

  @@index([category], map: "idx_pleading_templates_category")
  @@map("pleading_templates")
}

model Pleading {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  matterId        String?  @map("matter_id") @db.Uuid
  templateId      String   @map("template_id") @db.Uuid
  inputData       Json     @map("input_data")
  generatedOutput Json?    @map("generated_output")
  citationsJson   Json     @default("[]") @map("citations_json")
  status          String   @default("pending") @db.VarChar(20)
  // status: pending, generating, completed, failed
  modelRunId      String?  @map("model_run_id") @db.Uuid
  jobId           String?  @map("job_id") @db.VarChar(100)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id])
  matter       Matter?          @relation(fields: [matterId], references: [id])
  template     PleadingTemplate @relation(fields: [templateId], references: [id])

  @@index([organizationId], map: "idx_pleadings_org")
  @@index([userId], map: "idx_pleadings_user")
  @@index([templateId], map: "idx_pleadings_template")
  @@index([status], map: "idx_pleadings_status")
  @@map("pleadings")
}

