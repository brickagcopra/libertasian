  @@index([status, scheduledAt], map: "idx_lifecycle_event_status_scheduled")
  @@index([subscriptionId], map: "idx_lifecycle_event_sub")
  @@index([eventType, status], map: "idx_lifecycle_event_type_status")
  @@map("subscription_lifecycle_events")
}

model TrialRecord {
