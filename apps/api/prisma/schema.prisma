model CommunityRating {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  entityType  String   @map("entity_type") @db.VarChar(30)
  // entityType: flashcard_set, reviewer_pack, digest
  entityId    String   @map("entity_id") @db.Uuid
  score       Int
  // score: 1-5 stars
  reviewTitle String?  @map("review_title") @db.VarChar(255)
  reviewBody  String?  @map("review_body")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType, entityId], map: "uq_community_rating_user_entity")
  @@index([entityType, entityId], map: "idx_community_ratings_entity")
  @@index([entityType, entityId, score], map: "idx_community_ratings_entity_score")
  @@map("community_ratings")
}

model CommunityVote {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  entityType String   @map("entity_type") @db.VarChar(30)
  // entityType: digest (for community digest curation)
  entityId   String   @map("entity_id") @db.Uuid
  voteType   String   @map("vote_type") @db.VarChar(10)
  // voteType: up, down
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType, entityId], map: "uq_community_vote_user_entity")
  @@index([entityType, entityId], map: "idx_community_votes_entity")
  @@map("community_votes")
}

model CommunityFlag {
  id               String    @id @default(uuid()) @db.Uuid
  reporterUserId   String    @map("reporter_user_id") @db.Uuid
  entityType       String    @map("entity_type") @db.VarChar(30)
  // entityType: flashcard_set, reviewer_pack, digest, community_rating
  entityId         String    @map("entity_id") @db.Uuid
  reason           String    @db.VarChar(50)
  // reason: spam, inappropriate, copyright, inaccurate, other
  details          String?
  status           String    @default("open") @db.VarChar(20)
  // status: open, dismissed, actioned
  resolvedByUserId String?   @map("resolved_by_user_id") @db.Uuid
  resolutionNote   String?   @map("resolution_note")
  resolvedAt       DateTime? @map("resolved_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  reporter   User  @relation("CommunityFlagReporter", fields: [reporterUserId], references: [id], onDelete: Cascade)
  resolvedBy User? @relation("CommunityFlagResolver", fields: [resolvedByUserId], references: [id])

  @@index([entityType, entityId], map: "idx_community_flags_entity")
  @@index([status], map: "idx_community_flags_status")
  @@map("community_flags")
}

model ExpertVerification {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @unique @map("user_id") @db.Uuid
  expertiseType     String    @map("expertise_type") @db.VarChar(30)
  // expertiseType: lawyer, law_professor, judge_retired, legal_researcher
  credentialDetails String?   @map("credential_details")
  // credentialDetails: JSON-stringified evidence (roll number, school, etc.)
  status            String    @default("pending") @db.VarChar(20)
  // status: pending, approved, rejected, revoked
  reviewNote        String?   @map("review_note")
  reviewedAt        DateTime? @map("reviewed_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status], map: "idx_expert_verification_status")
  @@map("expert_verifications")
}

// ==========================================================================
// 5.11 RBAC — Role-Based Access Control (NIST Model)
// ==========================================================================

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(100)
  // code: "resource:action" format, e.g. "documents:read", "digests:approve"
  resource    String   @db.VarChar(50)
  action      String   @db.VarChar(50)
  category    String   @db.VarChar(30)
  // category: corpus, digests, editorial, workspace, ai, study, search, admin, billing, community
  description String?  @db.VarChar(500)
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  rolePermissions RolePermission[]

  @@index([category], map: "idx_permissions_category")
  @@index([resource], map: "idx_permissions_resource")
  @@map("permissions")
}

model RoleDefinition {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  // null = system-wide default role; non-null = org-scoped custom role
  name           String   @db.VarChar(100)
  slug           String   @db.VarChar(100)
  description    String?  @db.VarChar(500)
  isSystem       Boolean  @default(false) @map("is_system")
  requiresMfa    Boolean  @default(false) @map("requires_mfa")
  maxPerOrg      Int?     @map("max_per_org")
  // maxPerOrg: optional cardinality limit (e.g., owner = 1)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  organization    Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  memberRoles     MemberRole[]
  parentEdges     RoleHierarchy[]  @relation("HierarchyParent")
  childEdges      RoleHierarchy[]  @relation("HierarchyChild")
  constraintsAsA  RoleConstraint[] @relation("ConstraintRoleA")
  constraintsAsB  RoleConstraint[] @relation("ConstraintRoleB")

  @@unique([organizationId, slug], map: "uq_role_definition_org_slug")
  @@index([isSystem], map: "idx_role_definitions_system")
  @@map("role_definitions")
}

model RolePermission {
  id           String @id @default(uuid()) @db.Uuid
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  // Relations
  role       RoleDefinition @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission     @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId], map: "uq_role_permission")
  @@index([roleId], map: "idx_role_permissions_role")
  @@index([permissionId], map: "idx_role_permissions_permission")
  @@map("role_permissions")
}

model RoleHierarchy {
  id           String @id @default(uuid()) @db.Uuid
  parentRoleId String @map("parent_role_id") @db.Uuid
  childRoleId  String @map("child_role_id") @db.Uuid

  // Relations
  parentRole RoleDefinition @relation("HierarchyParent", fields: [parentRoleId], references: [id], onDelete: Cascade)
  childRole  RoleDefinition @relation("HierarchyChild", fields: [childRoleId], references: [id], onDelete: Cascade)

  @@unique([parentRoleId, childRoleId], map: "uq_role_hierarchy_edge")
  @@index([parentRoleId], map: "idx_role_hierarchy_parent")
  @@index([childRoleId], map: "idx_role_hierarchy_child")
  @@map("role_hierarchy")
}

model RoleConstraint {
  id             String @id @default(uuid()) @db.Uuid
  roleAId        String @map("role_a_id") @db.Uuid
  roleBId        String @map("role_b_id") @db.Uuid
  constraintType String @map("constraint_type") @db.VarChar(30)
  // constraintType: mutually_exclusive, prerequisite, cardinality

  // Relations
  roleA RoleDefinition @relation("ConstraintRoleA", fields: [roleAId], references: [id], onDelete: Cascade)
  roleB RoleDefinition @relation("ConstraintRoleB", fields: [roleBId], references: [id], onDelete: Cascade)

  @@unique([roleAId, roleBId, constraintType], map: "uq_role_constraint")
  @@index([roleAId], map: "idx_role_constraints_a")
  @@index([roleBId], map: "idx_role_constraints_b")
  @@map("role_constraints")
}

model MemberRole {
  id                   String    @id @default(uuid()) @db.Uuid
  organizationMemberId String    @map("organization_member_id") @db.Uuid
  roleDefinitionId     String    @map("role_definition_id") @db.Uuid
  assignedByUserId     String?   @map("assigned_by_user_id") @db.Uuid
  expiresAt            DateTime? @map("expires_at") @db.Timestamptz
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  organizationMember OrganizationMember @relation(fields: [organizationMemberId], references: [id], onDelete: Cascade)
  roleDefinition     RoleDefinition     @relation(fields: [roleDefinitionId], references: [id], onDelete: Cascade)
  assignedBy         User?              @relation("MemberRoleAssignedBy", fields: [assignedByUserId], references: [id])

  @@unique([organizationMemberId, roleDefinitionId], map: "uq_member_role")
  @@index([organizationMemberId], map: "idx_member_roles_member")
  @@index([roleDefinitionId], map: "idx_member_roles_role")
  @@index([expiresAt], map: "idx_member_roles_expires")
  @@map("member_roles")
}

// ==========================================================================
// 5.12 Plans, Pricing & Feature Flags
// ==========================================================================

model Plan {
  id                  String   @id @default(uuid()) @db.Uuid
  code                String   @unique @db.VarChar(50)
  name                String   @db.VarChar(100)
  displayName         String   @map("display_name") @db.VarChar(100)
  description         String?
  type                String   @default("standard") @db.VarChar(30)
  // type: free, standard, team, enterprise, legacy, custom
  category            String   @default("individual") @db.VarChar(30)
  // category: free, individual, student, team, firm, enterprise, legacy
  isActive            Boolean  @default(true) @map("is_active")
  isVisible           Boolean  @default(true) @map("is_visible")
  displayOrder        Int      @default(0) @map("display_order")
  trialEnabled        Boolean  @default(false) @map("trial_enabled")
  trialDurationDays   Int      @default(0) @map("trial_duration_days")
  gracePeriodDays     Int      @default(3) @map("grace_period_days")
  autoRenewRequired   Boolean  @default(true) @map("auto_renew_required")
  adminOnlyAssignment Boolean  @default(false) @map("admin_only_assignment")
  inviteOnly          Boolean  @default(false) @map("invite_only")
  eligibleSegments    Json     @default("[]") @map("eligible_segments")
  // eligibleSegments: ["law_student", "solo_lawyer", "firm", etc.]
  defaultSeats        Int      @default(1) @map("default_seats")
  maxSeats            Int?     @map("max_seats")
  internalNotes       String?  @map("internal_notes")
  isArchived          Boolean  @default(false) @map("is_archived")
  isFeatured          Boolean  @default(false) @map("is_featured")
  featuredLabel       String?  @map("featured_label") @db.VarChar(50)
  ctaText             String?  @map("cta_text") @db.VarChar(50)
  highlightColor      String?  @map("highlight_color") @db.VarChar(20)
  isLegacy            Boolean  @default(false) @map("is_legacy")
  legacyMappingCode   String?  @map("legacy_mapping_code") @db.VarChar(50)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  prices                 PlanPrice[]
  entitlements           PlanEntitlement[]
  featureFlags           PlanFeatureFlag[]
  subscriptions          Subscription[]
  checkoutPriceSnapshots CheckoutPriceSnapshot[]

  @@index([isActive, isVisible], map: "idx_plans_active_visible")
  @@index([category], map: "idx_plans_category")
  @@index([displayOrder], map: "idx_plans_display_order")
  @@map("plans")
}

model PlanPrice {
  id              String   @id @default(uuid()) @db.Uuid
  planId          String   @map("plan_id") @db.Uuid
  billingInterval String   @map("billing_interval") @db.VarChar(20)
  // billingInterval: monthly, annual, quarterly, one_time
  amount          Int
  // amount in centavos (PHP smallest unit)
  currency        String   @default("PHP") @db.VarChar(3)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, billingInterval, currency], map: "uq_plan_price_interval_currency")
