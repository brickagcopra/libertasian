// NOTE: analytics_events is partitioned by month on created_at via raw SQL
// migration. Prisma model maps to the parent table. The app role has INSERT-only
// (no UPDATE/DELETE) enforced at the database level via raw migration.
model AnalyticsEvent {
  id             String   @default(uuid()) @db.Uuid
  eventName      String   @map("event_name") @db.VarChar(100)
  eventCategory  String   @map("event_category") @db.VarChar(50)
  // eventCategory: search, ai_answer, digest, scan, study, workspace, auth, billing, navigation, admin
  userId         String?  @map("user_id") @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  sessionId      String?  @map("session_id") @db.VarChar(100)
  deviceType     String?  @map("device_type") @db.VarChar(20)
  // deviceType: web, ios, android
  properties     Json     @default("{}") @db.JsonB
  // flexible event payload — validated against event taxonomy
  metadata       Json     @default("{}") @db.JsonB
  // user_agent, ip_hash, app_version, screen_resolution
  durationMs     Int?     @map("duration_ms")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@id([id, createdAt])
  @@index([eventName], map: "idx_analytics_event_name")
  @@index([eventCategory], map: "idx_analytics_event_category")
  @@index([sessionId], map: "idx_analytics_event_session")
  @@index([userId], map: "idx_analytics_event_user")
  @@index([createdAt], map: "idx_analytics_event_created")
  @@index([organizationId], map: "idx_analytics_event_org")
  @@map("analytics_events")
}

model AnalyticsSession {
  id              String    @id @db.VarChar(100)
  userId          String?   @map("user_id") @db.Uuid
  organizationId  String?   @map("organization_id") @db.Uuid
  deviceType      String?   @map("device_type") @db.VarChar(20)
  startedAt       DateTime  @default(now()) @map("started_at") @db.Timestamptz
  endedAt         DateTime? @map("ended_at") @db.Timestamptz
  durationSeconds Int?      @map("duration_seconds")
  pageCount       Int       @default(0) @map("page_count")
  eventCount      Int       @default(0) @map("event_count")
  entryPath       String?   @map("entry_path") @db.VarChar(500)
  exitPath        String?   @map("exit_path") @db.VarChar(500)
  referrer        String?   @db.VarChar(500)
  properties      Json      @default("{}") @db.JsonB
  // plan_code, role, geo_country

  @@index([userId], map: "idx_analytics_session_user")
  @@index([organizationId], map: "idx_analytics_session_org")
  @@index([startedAt], map: "idx_analytics_session_started")
  @@map("analytics_sessions")
}

model AnalyticsDailyAggregate {
  id             String   @id @default(uuid()) @db.Uuid
  date           DateTime @db.Date
  metricName     String   @map("metric_name") @db.VarChar(100)
  // e.g. 'dau', 'searches', 'ai_answers', 'digests_generated', 'scans_completed'
  dimension      String?  @db.VarChar(100)
  // e.g. 'plan:pro', 'device:ios', 'subject:criminal'
  metricValue    BigInt   @map("metric_value")
  uniqueUsers    Int      @default(0) @map("unique_users")
