// ==========================================================================
// 6.0 Accounting & Financial Intelligence
// ==========================================================================

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

enum AccountingPeriodStatus {
  OPEN
  CLOSED
}

enum JournalEntrySourceType {
  MANUAL
  PAYMENT
  REFUND
  REVENUE_RECOGNITION
  EXPENSE
  SUBSCRIPTION_CHANGE
  SYSTEM
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  VOID
}

enum RevenueScheduleStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum BillingPeriodType {
  MONTHLY
  ANNUAL
}

enum ExpenseCategory {
  INFRASTRUCTURE
  PERSONNEL
  AI_COMPUTE
  PAYMENT_PROCESSING
  MARKETING
  LEGAL
  OFFICE
  SOFTWARE_LICENSES
  PROFESSIONAL_SERVICES
  OTHER
}

enum ExpenseStatus {
  PENDING
  APPROVED
  RECORDED
  REJECTED
}

enum RecurrenceType {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum SnapshotType {
  INCOME_STATEMENT
  BALANCE_SHEET
  CASH_FLOW
}

// Chart of Accounts — the backbone of double-entry accounting
model ChartOfAccount {
  id            String        @id @default(uuid()) @db.Uuid
  code          String        @unique @db.VarChar(10)
  name          String        @db.VarChar(255)
  accountType   AccountType   @map("account_type")
  subType       String?       @map("sub_type") @db.VarChar(50)
  // subType: e.g. current_asset, non_current_asset, current_liability, etc.
  parentCode    String?       @map("parent_code") @db.VarChar(10)
  normalBalance NormalBalance @map("normal_balance")
  isActive      Boolean       @default(true) @map("is_active")
  description   String?
  displayOrder  Int           @default(0) @map("display_order")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  journalEntryLines JournalEntryLine[]
  expenseRecords    ExpenseRecord[]
  budgetItems       BudgetItem[]

  @@index([accountType], map: "idx_coa_account_type")
  @@index([parentCode], map: "idx_coa_parent_code")
  @@index([displayOrder], map: "idx_coa_display_order")
  @@map("chart_of_accounts")
}

// Accounting periods — typically monthly
model AccountingPeriod {
  id         String                 @id @default(uuid()) @db.Uuid
  periodName String                 @unique @map("period_name") @db.VarChar(20)
  // periodName: e.g. "2026-01", "2026-02"
  startDate  DateTime               @map("start_date") @db.Date
  endDate    DateTime               @map("end_date") @db.Date
  status     AccountingPeriodStatus @default(OPEN)
  closedById String?                @map("closed_by_id") @db.Uuid
  closedAt   DateTime?              @map("closed_at") @db.Timestamptz
  createdAt  DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  closedBy            User?                     @relation("PeriodClosedBy", fields: [closedById], references: [id])
  journalEntries      JournalEntry[]
  revenueRecognitions RevenueRecognitionEntry[]
  expenseRecords      ExpenseRecord[]
  budgetItems         BudgetItem[]
  financialSnapshots  FinancialSnapshot[]
  saasMetrics         SaasMetricsMonthly?

  @@index([status], map: "idx_accounting_period_status")
  @@index([startDate, endDate], map: "idx_accounting_period_dates")
  @@map("accounting_periods")
}

// Journal Entry — header for a double-entry transaction
model JournalEntry {
  id          String                 @id @default(uuid()) @db.Uuid
  entryNumber Int                    @unique @default(autoincrement()) @map("entry_number")
  periodId    String                 @map("period_id") @db.Uuid
  entryDate   DateTime               @map("entry_date") @db.Date
  description String
  sourceType  JournalEntrySourceType @map("source_type")
  sourceRefId String?                @map("source_ref_id") @db.Uuid
  status      JournalEntryStatus     @default(DRAFT)
  postedById  String?                @map("posted_by_id") @db.Uuid
  postedAt    DateTime?              @map("posted_at") @db.Timestamptz
  voidedById  String?                @map("voided_by_id") @db.Uuid
  voidedAt    DateTime?              @map("voided_at") @db.Timestamptz
  voidReason  String?                @map("void_reason")
  notes       String?
  isAuto      Boolean                @default(false) @map("is_auto")
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  period              AccountingPeriod          @relation(fields: [periodId], references: [id])
  postedBy            User?                     @relation("JournalEntryPostedBy", fields: [postedById], references: [id])
  voidedBy            User?                     @relation("JournalEntryVoidedBy", fields: [voidedById], references: [id])
  lines               JournalEntryLine[]
  revenueRecognitions RevenueRecognitionEntry[]

  @@index([periodId, status], map: "idx_je_period_status")
  @@index([sourceType, sourceRefId], map: "idx_je_source")
  @@index([entryDate], map: "idx_je_entry_date")
  @@index([status], map: "idx_je_status")
  @@map("journal_entries")
}

// Journal Entry Line — individual debit or credit entry
model JournalEntryLine {
  id             String   @id @default(uuid()) @db.Uuid
  journalEntryId String   @map("journal_entry_id") @db.Uuid
  accountId      String   @map("account_id") @db.Uuid
  debitAmount    Int      @default(0) @map("debit_amount")
  // amount in centavos
  creditAmount   Int      @default(0) @map("credit_amount")
  // amount in centavos
  description    String?
  organizationId String?  @map("organization_id") @db.Uuid
  subscriptionId String?  @map("subscription_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  journalEntry JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      ChartOfAccount @relation(fields: [accountId], references: [id])
  organization Organization?  @relation(fields: [organizationId], references: [id])
  subscription Subscription?  @relation(fields: [subscriptionId], references: [id])

  @@index([journalEntryId], map: "idx_jel_journal_entry")
  @@index([accountId, journalEntryId], map: "idx_jel_account_entry")
  @@index([organizationId], map: "idx_jel_organization")
  @@map("journal_entry_lines")
}

// Revenue schedule for deferred revenue recognition (annual billing)
model RevenueSchedule {
  id                 String                @id @default(uuid()) @db.Uuid
  subscriptionId     String                @map("subscription_id") @db.Uuid
  organizationId     String                @map("organization_id") @db.Uuid
  planCode           String                @map("plan_code") @db.VarChar(50)
  billingPeriod      BillingPeriodType     @map("billing_period")
  totalAmount        Int                   @map("total_amount")
  // total payment in centavos
  recognizedAmount   Int                   @default(0) @map("recognized_amount")
  // cumulative recognized revenue in centavos
  deferredAmount     Int                   @map("deferred_amount")
  // remaining deferred revenue in centavos
  recognitionStart   DateTime              @map("recognition_start") @db.Date
  recognitionEnd     DateTime              @map("recognition_end") @db.Date
  monthlyRecognition Int                   @map("monthly_recognition")
  // monthly revenue recognition amount in centavos
  status             RevenueScheduleStatus @default(ACTIVE)
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  subscription Subscription              @relation(fields: [subscriptionId], references: [id])
  organization Organization              @relation(fields: [organizationId], references: [id])
  entries      RevenueRecognitionEntry[]

  @@index([status], map: "idx_rev_schedule_status")
  @@index([organizationId], map: "idx_rev_schedule_org")
  @@index([subscriptionId], map: "idx_rev_schedule_sub")
  @@map("revenue_schedules")
}

// Individual revenue recognition entry for a period
model RevenueRecognitionEntry {
  id                String   @id @default(uuid()) @db.Uuid
  revenueScheduleId String   @map("revenue_schedule_id") @db.Uuid
  periodId          String   @map("period_id") @db.Uuid
