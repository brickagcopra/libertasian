# Set this when running `pnpm --filter mobile start` from a workstation if you
# want the phone (Expo Go or dev client) to hit the deployed prod API instead
# of localhost. Leave unset to use the default __DEV__ loopback (Android
# emulator: 10.0.2.2:3001, iOS simulator: localhost:3001) in development, or
# the app.json `extra.apiUrl` value in production builds.
EXPO_PUBLIC_API_URL=https://libertasian.com/api/v1
