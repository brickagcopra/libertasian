# Set this when running `pnpm --filter mobile start` from a workstation if you
# want the phone (Expo Go or dev client) to hit the deployed prod API instead
# of localhost. Leave unset to use the default __DEV__ loopback (Android
# emulator: 10.0.2.2:3001, iOS simulator: localhost:3001) in development, or
# the app.json `extra.apiUrl` value in production builds.
EXPO_PUBLIC_API_URL=https://libertasian.com/api/v1

# Native Google Sign-In (both required for the Google button to activate; when
# missing, the button falls back to the "Coming soon" alert).
# - WEB client ID: the existing web OAuth client — GoogleSignin needs it as
#   `webClientId` so Android/iOS mint an idToken the API can verify.
# - iOS client ID: the iOS OAuth client (bundle com.libertasian.app). Also
#   consumed by app.config.js at build time to derive the reversed
#   `iosUrlScheme` for the google-signin config plugin, so it must be present
#   in the EAS build profile env (native builds only — not OTA-updatable).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
