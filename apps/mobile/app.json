{
  "expo": {
    "name": "LIBERTASIAN",
    "slug": "libertasian",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "libertasian",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.libertasian.app",
      "buildNumber": "1",
      "associatedDomains": [
        "applinks:libertasian.com"
      ]
    },
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.libertasian.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "libertasian.com",
              "pathPrefix": "/shared"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "extra": {
      "apiUrl": "https://libertasian.com/api/v1",
      "eas": {
        "projectId": "4da67afe-0d1f-4da9-affe-d1d642f77a79"
      },
      "router": {
        "origin": false
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-sqlite"
    ],
    "owner": "brickagcopra"
  }
}
