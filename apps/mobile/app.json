{
  "expo": {
    "name": "LIBERTASIAN",
    "slug": "libertasian",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "libertasian",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f6f1e8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.libertasian.app",
      "buildNumber": "17",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:libertasian.com"
      ],
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "NSCameraUsageDescription": "LIBERTASIAN uses the camera to scan legal documents into searchable digests.",
        "NSPhotoLibraryUsageDescription": "LIBERTASIAN reads selected images from your library to upload as legal document scans.",
        "NSPhotoLibraryAddUsageDescription": "LIBERTASIAN saves rendered digests and shared documents to your photo library.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "versionCode": 9,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f6f1e8"
      },
      "googleServicesFile": "./google-services.json",
      "package": "com.libertasian.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "libertasian.com",
              "pathPrefix": "/shared"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "extra": {
      "apiUrl": "https://libertasian.com/api/v1",
      "eas": {
        "projectId": "4da67afe-0d1f-4da9-affe-d1d642f77a79"
      },
      "router": {
        "origin": false
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35
          }
        }
      ],
      "expo-router",
      "expo-apple-authentication",
      "expo-secure-store",
      "expo-notifications",
      "@react-native-community/datetimepicker",
      "expo-sqlite",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "LIBERTASIAN uses the camera to scan legal documents into searchable digests.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "LIBERTASIAN reads selected images from your library to upload as legal document scans.",
          "cameraPermission": "LIBERTASIAN uses the camera to scan legal documents into searchable digests."
        }
      ]
    ],
    "owner": "brickagcopra"
  }
}
