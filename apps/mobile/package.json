{
  "name": "@libertasian/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build": "echo 'mobile build - use EAS Build'",
    "//eas-build-post-install": "Second lock on the same door as packages/types' `prepare`. @libertasian/types has `main: ./dist/index.js` and dist/ is gitignored, so a clean EAS checkout has no runtime entry point and Metro fails to resolve the first VALUE import (src/features/search/document-types.ts) 90s into EAGER_BUNDLE with an opaque error. POST-install, not pre-install: building needs the workspace devDependencies present. The require() turns a missing dist into a loud, immediate failure at the hook. A no-op when dist is already built.",
    "eas-build-post-install": "pnpm --filter @libertasian/types build && node -e \"require('@libertasian/types')\"",
    "//lint": "Router types MUST be generated before tsc: without .expo/types/router.d.ts the Href union never loads, every route degrades to `string`, and dead paths type-check green. Chained with && rather than a prelint hook because pnpm ships enable-pre-post-scripts=false, so a prelint script would silently never run.",
    "lint": "pnpm run generate:router-types && tsc --noEmit",
    "test": "jest",
    "type-check": "pnpm run generate:router-types && tsc --noEmit",
    "generate:router-types": "node scripts/generate-router-types.mjs",
    "generate:assets": "node scripts/generate-assets.mjs",
    "screenshots:capture": "node scripts/capture-screenshots.mjs",
    "screenshots:frame": "node scripts/frame-screenshots.mjs",
    "screenshots:marketing": "node scripts/generate-store-screenshots.mjs"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.2",
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/instrument-serif": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^14.0.4",
    "@libertasian/types": "workspace:*",
    "@react-native-community/datetimepicker": "^8.2.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-google-signin/google-signin": "^13.2.0",
    "@react-native-picker/picker": "^2.11.0",
    "@react-navigation/elements": "2.9.10",
    "@tanstack/react-query": "^5.62.0",
    "expo": "~52.0.0",
    "expo-apple-authentication": "~7.1.3",
    "expo-av": "~15.0.2",
    "expo-build-properties": "^0.13.3",
    "expo-camera": "^16.0.18",
    "expo-clipboard": "^7.0.1",
    "expo-constants": "~17.0.0",
    "expo-dev-client": "^5.0.20",
    "expo-device": "~7.0.3",
    "expo-file-system": "^18.0.12",
    "expo-font": "^13.0.4",
    "expo-image-manipulator": "^13.0.6",
    "expo-image-picker": "^16.0.6",
    "expo-linear-gradient": "~14.0.0",
    "expo-linking": "~7.0.0",
    "expo-notifications": "~0.29.14",
    "expo-router": "~4.0.0",
    "expo-secure-store": "~14.0.0",
    "expo-sharing": "^13.0.1",
    "expo-sqlite": "~15.1.4",
    "expo-status-bar": "~2.0.0",
    "nativewind": "^4.2.3",
    "react": "^18.3.1",
    "react-native": "0.76.9",
    "react-native-mmkv": "^3.2.0",
    "react-native-purchases": "9.15.2",
    "react-native-safe-area-context": "^4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "^15.8.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@libertasian/tsconfig": "workspace:*",
    "@testing-library/react-native": "^12.8.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~18.3.0",
    "jest-expo": "~52.0.0",
    "sharp": "^0.34.5",
    "tailwindcss": "3.4.0",
    "typescript": "^5.7.0"
  }
}
