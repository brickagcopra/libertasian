{
  "cli": {
    "version": ">= 15.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "22.13.0",
      "pnpm": "10.30.3",
      "env": {
        "API_URL": "https://libertasian.com/api/v1",
        "EXPO_PUBLIC_API_URL": "https://libertasian.com/api/v1"
      }
    },
    "preview": {
      "distribution": "internal",
      "developmentClient": false,
      "node": "22.13.0",
      "pnpm": "10.30.3",
      "env": {
        "API_URL": "https://libertasian.com/api/v1"
      },
      "android": {
        "node": "22.13.0",
        "pnpm": "10.30.3",
        "buildType": "apk",
        "env": {
          "EXPO_PUBLIC_API_URL": "https://libertasian.com/api/v1"
        }
      }
    },
    // Maestro E2E profile — Android APK pointed at an isolated test backend
    // exposed through ngrok. The CRUD-heavy flows MUST NOT hit dev or prod;
    // operators run a local API against a libertasian_e2e database seeded by
    // `pnpm --filter api seed:e2e` and tunnel port 3001 via a reserved static
    // ngrok domain. See apps/mobile/.maestro/README.md → "E2E backend via
    // ngrok" for the full runbook.
    "e2e": {
      "extends": "preview",
      "distribution": "internal",
      "developmentClient": false,
      "node": "22.13.0",
      "pnpm": "10.30.3",
      "env": {
        // TODO: brick — replace CHANGEME with your reserved ngrok static domain.
        "API_URL": "https://CHANGEME.ngrok-free.app/api/v1",
        "EXPO_PUBLIC_API_URL": "https://CHANGEME.ngrok-free.app/api/v1"
      },
      "android": {
        "node": "22.13.0",
        "pnpm": "10.30.3",
        "buildType": "apk",
        "env": {
          // TODO: brick — replace CHANGEME with your reserved ngrok static domain.
          "EXPO_PUBLIC_API_URL": "https://CHANGEME.ngrok-free.app/api/v1"
        }
      }
    },
    "production": {
      "node": "22.13.0",
      "pnpm": "10.30.3",
      "env": {
        "API_URL": "https://libertasian.com/api/v1"
      },
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "android": {
        // TODO: Replace with Play Console service account JSON.
        // Get from: Play Console -> Setup -> API access -> service account -> create key (JSON) -> download.
        // File should be saved at apps/mobile/google-services.json (gitignored).
        "serviceAccountKeyPath": "./google-services.json",
        "track": "internal"
      },
      "ios": {
        // TODO: Replace with the Apple ID email used to sign in to App Store Connect.
        "appleId": "YOUR_APPLE_ID",
        // TODO: Replace with App Store Connect App ID. Created when the app is registered in App Store Connect -> My Apps -> + -> New App. Shown in app's App Information page.
        "ascAppId": "YOUR_APP_STORE_CONNECT_APP_ID",
        // TODO: Replace with Apple Developer Team ID. Found at developer.apple.com -> Account -> Membership details.
        "appleTeamId": "YOUR_TEAM_ID"
      }
    }
  }
}
