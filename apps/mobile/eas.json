{
  "cli": {
    "version": ">= 15.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "22.13.0",
      "pnpm": "10.30.3",
      "env": {
        "API_URL": "https://libertasian.com/api/v1",
        "EXPO_PUBLIC_API_URL": "https://libertasian.com/api/v1"
      }
    },
    "preview": {
      "distribution": "internal",
      "developmentClient": false,
      "node": "22.13.0",
      "pnpm": "10.30.3",
      "env": {
        "API_URL": "https://libertasian.com/api/v1"
      },
      "android": {
        "node": "22.13.0",
        "pnpm": "10.30.3",
        "buildType": "apk",
        "env": {
          "EXPO_PUBLIC_API_URL": "https://libertasian.com/api/v1",
          // The SAME public OAuth client IDs the production profile uses.
          // Without them an internal build inlines `undefined` for both, and
          // because EXPO_PUBLIC_* is baked in at bundle time no OTA can add
          // them afterwards: the Google button short-circuits to
          // `unavailable` before it ever reaches the native module. Google
          // sign-in was therefore untestable on exactly the builds testers
          // install. Client IDs are public identifiers, not secrets — they
          // already ship inside every production binary.
          "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "611735597639-gritsa8iokpu4h8t5kmbmfum9m3sr6fc.apps.googleusercontent.com",
          "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "611735597639-pu2f1jbvsunsbt7sfhglhoo4i82kj1b9.apps.googleusercontent.com"
        }
      }
    },
    "preview:simulator": {
      "extends": "preview",
      "ios": {
        "node": "22.13.0",
        "pnpm": "10.30.3",
        "simulator": true,
        "env": {
          "EXPO_PUBLIC_API_URL": "https://libertasian.com/api/v1",
          // See the preview.android.env note above.
          "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "611735597639-gritsa8iokpu4h8t5kmbmfum9m3sr6fc.apps.googleusercontent.com",
          "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "611735597639-pu2f1jbvsunsbt7sfhglhoo4i82kj1b9.apps.googleusercontent.com"
        }
      }
    },
    "production": {
      "node": "22.13.0",
      "pnpm": "10.30.3",
      "env": {
        "API_URL": "https://libertasian.com/api/v1",
        "EXPO_PUBLIC_API_URL": "https://libertasian.com/api/v1",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "611735597639-gritsa8iokpu4h8t5kmbmfum9m3sr6fc.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "611735597639-pu2f1jbvsunsbt7sfhglhoo4i82kj1b9.apps.googleusercontent.com",
        // RevenueCat PUBLISHABLE (SDK) key for iOS — safe in the repo. It is
        // the client-side key every installed binary already carries, NOT the
        // secret API key, which stays server-side and out of version control.
        // Like every EXPO_PUBLIC_* value it is inlined at bundle time, so it
        // has to be present at build time or no OTA can add it later.
        //
        // There is deliberately NO EXPO_PUBLIC_REVENUECAT_ANDROID_KEY here —
        // but the reason has changed since this comment was first written.
        //
        // OUTDATED (2026-08-30): this used to say RevenueCat's Play app was
        // failing credential validation and that no Android key existed. Both
        // are now false. The Play service account validates — RevenueCat reads
        // "Valid credentials" — and an Android publishable key does exist:
        // goog_VjSuppDTBPHUMUULFkfgFSdkoxL.
        //
        // THE CURRENT REASON IS THAT THERE IS NOTHING TO SELL. Google Play has
        // ZERO subscription products: the Subscriptions page was inaccessible
        // until a payments profile existed, so no product has ever been
        // created. Setting this key would configure the SDK against an empty
        // catalogue — every offering lookup returns nothing and the purchase
        // surface renders as broken rather than as "unavailable", which is the
        // state `purchases-sdk.ts` is written to produce.
        //
        // Add it only once the four Play products exist and are active.
        "EXPO_PUBLIC_REVENUECAT_IOS_KEY": "appl_knNgEKraBeaKizidAemKpaHnHwS"
      },
      "autoIncrement": true,
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.2"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        // TODO: Replace with Play Console service account JSON (a real secret — stays gitignored).
        // Get from: Play Console -> Setup -> API access -> service account -> create key (JSON) -> download.
        // File should be saved at apps/mobile/play-service-account.json (gitignored).
        // NOTE: distinct from google-services.json, which is Firebase CLIENT config
        // (public identifiers, safe to commit) referenced by app.json for FCM push.
        "serviceAccountKeyPath": "./play-service-account.json",
        // "alpha" is Play's default CLOSED testing track. It must not be
        // "internal": internal-track releases do NOT count toward the
        // 12-testers/14-continuous-days requirement that gates production
        // access for personal developer accounts, so an internal submit
        // silently burns days without advancing the clock.
        "track": "alpha",
        // "draft" USED to be required here. Play rejects a COMPLETED release
        // with "the app is missing the required metadata" until the app has
        // been through its FIRST review, because the store listing and App
        // content declarations are still pending. Submissions 1d1d1fe9
        // (versionCode 9) and 9c08591f (versionCode 11) both died on exactly
        // that, so submits went out as drafts and were published by hand via
        // Publishing overview -> "Send app for review".
        // That condition is now MET: the first review was approved and
        // versionCode 11 went live on the alpha track on 2026-08-18
        // ("Available to testers on Google Play", full rollout). So this is
        // back to "completed" and later submits roll out to testers directly,
        // with no manual publish step.
        "releaseStatus": "completed"
      },
      "ios": {
        "appleId": "bma5871@gmail.com",
        "ascAppId": "6788971669",
        "appleTeamId": "V2W2BY5P8D"
      }
    }
  }
}
