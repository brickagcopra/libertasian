{
  "cli": {
    "version": ">= 15.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "22.13.0",
      "pnpm": "10.30.3",
      "env": {
        "API_URL": "https://libertasian.com/api/v1",
        "EXPO_PUBLIC_API_URL": "https://libertasian.com/api/v1"
      }
    },
    "preview": {
      "distribution": "internal",
      "developmentClient": false,
      "node": "22.13.0",
      "pnpm": "10.30.3",
      "env": {
        "API_URL": "https://libertasian.com/api/v1"
      },
      "android": {
        "node": "22.13.0",
        "pnpm": "10.30.3",
        "buildType": "apk",
        "env": {
          "EXPO_PUBLIC_API_URL": "https://libertasian.com/api/v1",
          // The SAME public OAuth client IDs the production profile uses.
          // Without them an internal build inlines `undefined` for both, and
          // because EXPO_PUBLIC_* is baked in at bundle time no OTA can add
          // them afterwards: the Google button short-circuits to
          // `unavailable` before it ever reaches the native module. Google
          // sign-in was therefore untestable on exactly the builds testers
          // install. Client IDs are public identifiers, not secrets — they
          // already ship inside every production binary.
          "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "611735597639-gritsa8iokpu4h8t5kmbmfum9m3sr6fc.apps.googleusercontent.com",
          "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "611735597639-pu2f1jbvsunsbt7sfhglhoo4i82kj1b9.apps.googleusercontent.com"
        }
      }
    },
    "preview:simulator": {
      "extends": "preview",
      "ios": {
        "node": "22.13.0",
        "pnpm": "10.30.3",
        "simulator": true,
        "env": {
          "EXPO_PUBLIC_API_URL": "https://libertasian.com/api/v1",
          // See the preview.android.env note above.
          "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "611735597639-gritsa8iokpu4h8t5kmbmfum9m3sr6fc.apps.googleusercontent.com",
          "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "611735597639-pu2f1jbvsunsbt7sfhglhoo4i82kj1b9.apps.googleusercontent.com"
        }
      }
    },
    "production": {
      "node": "22.13.0",
      "pnpm": "10.30.3",
      "env": {
        "API_URL": "https://libertasian.com/api/v1",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "611735597639-gritsa8iokpu4h8t5kmbmfum9m3sr6fc.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "611735597639-pu2f1jbvsunsbt7sfhglhoo4i82kj1b9.apps.googleusercontent.com"
      },
      "autoIncrement": true,
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.2"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        // TODO: Replace with Play Console service account JSON (a real secret — stays gitignored).
        // Get from: Play Console -> Setup -> API access -> service account -> create key (JSON) -> download.
        // File should be saved at apps/mobile/play-service-account.json (gitignored).
        // NOTE: distinct from google-services.json, which is Firebase CLIENT config
        // (public identifiers, safe to commit) referenced by app.json for FCM push.
        "serviceAccountKeyPath": "./play-service-account.json",
        // "alpha" is Play's default CLOSED testing track. It must not be
        // "internal": internal-track releases do NOT count toward the
        // 12-testers/14-continuous-days requirement that gates production
        // access for personal developer accounts, so an internal submit
        // silently burns days without advancing the clock.
        "track": "alpha",
        // "draft" uploads the .aab as a DRAFT release on the alpha track instead
        // of publishing it immediately. Play rejects a COMPLETED release with
        // "the app is missing the required metadata" until the app has been
        // through its FIRST review, because the store listing and App content
        // declarations are still pending. Submissions 1d1d1fe9 (versionCode 9)
        // and 9c08591f (versionCode 11) both died on exactly that.
        // With "draft", the bundle lands in the track and you press
        // Publishing overview -> "Send app for review", which submits the
        // release together with the listing and declarations in one go.
        // AFTER the first review has been approved, change this back to
        // "completed" so later submits roll out to testers without a manual step.
        "releaseStatus": "draft"
      },
      "ios": {
        "appleId": "bma5871@gmail.com",
        "ascAppId": "6788971669",
        "appleTeamId": "V2W2BY5P8D"
      }
    }
  }
}
