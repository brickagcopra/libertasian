{
  "cli": {
    "version": ">= 15.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "22.13.0",
      "pnpm": "10.30.3",
      "env": {
        "API_URL": "https://libertasian.com/api/v1",
        "EXPO_PUBLIC_API_URL": "https://libertasian.com/api/v1"
      }
    },
    "preview": {
      "distribution": "internal",
      "developmentClient": false,
      "node": "22.13.0",
      "pnpm": "10.30.3",
      "env": {
        "API_URL": "https://libertasian.com/api/v1"
      },
      "android": {
        "node": "22.13.0",
        "pnpm": "10.30.3",
        "buildType": "apk",
        "env": {
          "EXPO_PUBLIC_API_URL": "https://libertasian.com/api/v1"
        }
      }
    },
    "preview:simulator": {
      "extends": "preview",
      "ios": {
        "node": "22.13.0",
        "pnpm": "10.30.3",
        "simulator": true,
        "env": {
          "EXPO_PUBLIC_API_URL": "https://libertasian.com/api/v1"
        }
      }
    },
    "production": {
      "node": "22.13.0",
      "pnpm": "10.30.3",
      "env": {
        "API_URL": "https://libertasian.com/api/v1"
      },
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "android": {
        // TODO: Replace with Play Console service account JSON (a real secret — stays gitignored).
        // Get from: Play Console -> Setup -> API access -> service account -> create key (JSON) -> download.
        // File should be saved at apps/mobile/play-service-account.json (gitignored).
        // NOTE: distinct from google-services.json, which is Firebase CLIENT config
        // (public identifiers, safe to commit) referenced by app.json for FCM push.
        "serviceAccountKeyPath": "./play-service-account.json",
        "track": "internal"
      },
      "ios": {
        "appleId": "bma5871@gmail.com",
        // TODO: Replace with the numeric App Store Connect App ID once the ASC app exists — `eas submit` offers to create it on first run, then shows the ID (also on the app's App Information page in ASC).
        "ascAppId": "YOUR_APP_STORE_CONNECT_APP_ID",
        "appleTeamId": "V2W2BY5P8D"
      }
    }
  }
}
