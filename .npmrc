auto-install-peers=true
strict-peer-dependencies=false

# Hoist all expo packages to root node_modules so Expo's react-native.config.js
# require('expo-modules-autolinking/exports') can resolve via Node's tree walk.
# pnpm's default symlink layout silently breaks the autolinking override and
# falls back to the wrong gradle namespace (expo.core vs expo.modules).
public-hoist-pattern[]=*expo*
