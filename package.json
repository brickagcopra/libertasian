{
  "name": "libertasian",
  "version": "0.0.0",
  "private": true,
  "description": "Philippine Legal AI Platform — Monorepo",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "analyze": "turbo run analyze",
    "clean": "turbo run clean",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "prisma",
      "@prisma/client",
      "@prisma/engines",
      "@nestjs/core",
      "bcrypt",
      "sharp"
    ],
    "overrides": {
      "handlebars": ">=4.7.9",
      "tar": ">=7.5.11",
      "@expo/cli>tar": "^6.2.1",
      "picomatch": ">=3.0.2",
      "node-forge": ">=1.4.0"
    }
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3"
  },
  "dependencies": {
    "expo": "~52.0.49",
    "react": "18.3.1",
    "react-native": "0.76.9"
  }
}
