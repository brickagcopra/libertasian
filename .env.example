# ===========================================
# LIBERTASIAN — Environment Variables Template
# Copy to .env and fill in actual values
# ===========================================

# Core
NODE_ENV=development
APP_PORT=3001
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# Database (PostgreSQL 16 + pgvector)
DATABASE_URL=postgresql://libertasian:libertasian_dev@localhost:5432/libertasian?schema=public
DATABASE_READ_REPLICA_URL=postgresql://readonly:libertasian_dev@localhost:5432/libertasian
DATABASE_POOL_SIZE=20

# Redis
REDIS_URL=redis://localhost:6379/0

# OpenSearch
OPENSEARCH_URL=https://localhost:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=LibertasianDev2024!
# Create the alias → *_v2 physical index topology at boot. Non-destructive:
# it never touches a concrete index already occupying an alias name.
SEARCH_AUTO_ENSURE_INDEXES=true
# Vector width the embedding service emits (BAAI/bge-small-en-v1.5 = 384).
# Must match the model — the knn_vector field is sized from this.
EMBEDDING_DIM=384
# Documents read per PostgreSQL page during POST /search/index/rebuild.
SEARCH_INDEX_REBUILD_BATCH_SIZE=500
# Ranking v2: tiered clauses, intent detection, native collapse. Set to
# 'false' to fall back to the legacy single-fuzzy-multi_match builder.
SEARCH_RANKER_V2=true
# Deepest reachable offset (page+1)*limit before the API returns 400.
SEARCH_MAX_WINDOW=1000
# RRF blends BM25 + kNN only inside this offset; deeper pages are lexical.
SEARCH_FUSION_WINDOW=100
# Below this top score the response is flagged meta.abstained.
SEARCH_MIN_SCORE=1.0
# function_score multipliers (official > semi-official > editorial).
SEARCH_BOOST_OFFICIAL=1.2
SEARCH_BOOST_TRUST_OFFICIAL=1.3
SEARCH_BOOST_TRUST_SEMI_OFFICIAL=1.15
SEARCH_BOOST_TRUST_EDITORIAL=1.0
# Recency decay: deliberately mild — landmark cases are decades old.
SEARCH_RECENCY_SCALE_DAYS=3650
SEARCH_RECENCY_DECAY=0.6
SEARCH_RECENCY_WEIGHT=1.1

# Object Storage (MinIO — S3-compatible)
S3_ENDPOINT=http://localhost:9000
# Browser-facing origin that presigned audio URLs are signed for (prod only).
# When set, getSignedUrl signs against this host instead of the internal
# S3_ENDPOINT so <audio> can resolve the URL. e.g. https://libertasian.com
S3_PUBLIC_ENDPOINT=
S3_ACCESS_KEY=libertasian
S3_SECRET_KEY=libertasian_dev_secret
S3_BUCKET_UPLOADS=libertasian-uploads
S3_BUCKET_CORPUS=libertasian-corpus
# MinIO ignores the region but SigV4 still signs it. Unset = 'us-east-1', the
# value this client used before it became configurable.
S3_REGION=

# Amazon Polly (Audio narration)
# Credentials are optional — the default AWS provider chain (env, shared
# config, IAM role) is used when these are unset.
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Matthew is a neural voice compatible with the default 'neural' engine.
POLLY_VOICE_ID=Matthew
POLLY_ENGINE=neural
# Wrap neural SSML in <amazon:domain name="news"> for a newscaster delivery.
# Set to 'false' to disable. Ignored on generative/long-form engines.
POLLY_NEWSCASTER=true

# Self-hosted TTS (Kokoro-82M). 'polly' (default) leaves the existing backend
# untouched; 'kokoro' routes synthesis to the internal tts-service. Because the
# Kokoro voice id differs from the Polly one, switching produces NEW rendition
# rows and never mutates existing ones — so the switch is fully reversible.
TTS_PROVIDER=polly
TTS_SERVICE_URL=http://tts-service:8003
KOKORO_VOICE_ID=af_heart

# Torch device for tts-service. Unset or 'auto' resolves to cuda when torch can
# see a device and cpu otherwise — the same answer kokoro reached internally
# before, except it is now decided explicitly, logged at startup, and REPORTED ON
# /health (`device`, `cuda_available`, `device_name`) so a GPU deployment can be
# verified instead of inferred from throughput.
#
# The GPU image (infrastructure/docker/Dockerfile.tts.gpu) bakes 'cuda' so a box
# with no visible device fails loudly rather than serving from CPU at ~1x
# realtime. `device=cuda` with `cuda_available=false` on /health means the
# container never got the card.
TTS_DEVICE=auto

# Worker/thread shape for tts-service. UNSET means device-shaped: 2 x 4 on CPU
# (the measured prod shape — 12 vCPU box that also serves the API) and 1 x 8 on
# CUDA, where one process should own the card. An explicit value always wins;
# docker-compose passes both explicitly, so prod is pinned either way.
#
# On a single GPU do NOT raise TTS_WORKERS: workers do not share the model, so
# each one is another full copy of the weights (~2.9 GiB measured) for no extra
# throughput. Scale AUDIO_PROCESSOR_CONCURRENCY on the API side instead. A
# multi-GPU host is the one legitimate reason to override it, and the service
# logs a warning when you do.
TTS_WORKERS=
TTS_THREADS_PER_WORKER=

# Bearer token for the API -> tts-service hop. LEAVE EMPTY in prod: the service
# uses `expose` (never `ports`), is absent from nginx, and only the API can
# reach it on the internal Docker network. Both sides no-op when it is empty.
#
# SET IT (same value on both sides) whenever tts-service is not on the API's own
# Docker network — e.g. the rented-GPU backfill host, where port 8003 is
# reachable from off-box. /health stays open either way, because the container
# HEALTHCHECK curls it with no credentials.
TTS_AUTH_TOKEN=

# Synthesis timeout model. The budget is length-proportional:
#   max(60s, chars / 13.5 chars-per-audio-second * KOKORO_REALTIME_FACTOR)
# capped by KOKORO_TIMEOUT_CEILING_MS. A document above that cap is SPLIT into
# consecutive batches under 80% of the ceiling and their audio concatenated;
# only a single segment that cannot fit on its own is refused, and it is refused
# BEFORE the call instead of being started and abandoned.
#
# Defaults (2.5 and 1,800,000 ms) are prod's measured CPU worst case with
# headroom and cap one call at ~9,720 chars — comfortably above the 2,032-char
# digest average, below the ~25,600-char decision average. A GPU host is roughly
# an order of magnitude faster and should set KOKORO_REALTIME_FACTOR≈0.25, which
# also raises that character cap ~10x. Unset means default.
KOKORO_REALTIME_FACTOR=
KOKORO_TIMEOUT_CEILING_MS=

# Cap on the total mp3 bytes ONE synthesis may produce. Chunking bounds how long
# a document may take, not how much audio it assembles in memory: the largest
# published codal (810,815 chars) encodes to ~343 MiB, held once in the batch
# list and again by the final concat, against a 1,048 MB Node heap in a 2 GB
# container. Default 157286400 (150 MiB, ~7 hours of narration). A document
# projected above it fails with reason `output_too_large` before any synthesis
# runs. Raise only after the audio path streams to storage instead of buffering.
KOKORO_MAX_OUTPUT_BYTES=

# Audio reconciler (the backfill). Both flags default false, so merging the
# feature changes nothing. AUDIO_RECONCILER_ENABLED covers tier 1 (digests,
# ~10.6 GB) and tier 2 (codals, ~1.7 GB). Tier 3 (decisions, ~158 GB) needs
# AUDIO_RECONCILE_DECISIONS as well.
#
# THE REMAINING TIER 3 BLOCKER IS COMPUTE, NOT DISK. Routing audio to R2 (see
# AUDIO_S3_* below) resolves the storage half — the ~158 GB no longer has to fit
# in the ~142 GB free on the MinIO volume. What is left is synthesis time:
# Kokoro measures ~0.97x realtime per worker on prod (2026-07-29), so 15,464
# decisions at ~1,870 audio-seconds each is on the order of 8,000 worker-hours.
# At 2 workers that is months of continuous synthesis on a box that also serves
# the API. Size that before flipping this flag; storage is no longer the gate.
AUDIO_RECONCILER_ENABLED=false
AUDIO_RECONCILE_DECISIONS=false
AUDIO_RECONCILE_BATCH=200
# Dry run: the reconciler runs every gap query and logs what it WOULD enqueue,
# then enqueues nothing. Requires AUDIO_RECONCILER_ENABLED=true — on its own it
# does nothing at all, because a disabled reconciler never reaches this code.
AUDIO_RECONCILE_DRY_RUN=false
# Path whose free space the disk guard measures (the MinIO volume mount).
AUDIO_STORAGE_PATH=/

# In-flight audio generation jobs. MUST NOT exceed TTS_WORKERS: extra jobs add
# no throughput, they queue inside the TTS service, and each concurrent
# synthesis costs ~2.9 GiB there. BullMQ's own default is 1, which left the
# second TTS worker idle.
AUDIO_PROCESSOR_CONCURRENCY=2

# Dedicated audio object storage (Cloudflare R2). LEAVE EVERY VALUE UNSET to
# keep audio on the shared MinIO bucket via S3Service — that is the current
# behaviour in every environment and setting nothing changes nothing.
#
# Only audio moves: all renditions are public_editorial corpus output, whereas
# user uploads and camera scans are private org data and stay on MinIO.
#
# THE R2 BUCKET MUST STAY PRIVATE. Clients receive short-TTL presigned GET URLs
# only; never enable public bucket access or attach a public r2.dev domain.
#
# SETTING THIS IS NOT RETROACTIVE: object keys already in `audio_renditions` are
# signed against whichever backend is active, so COPY THE 302 EXISTING MinIO
# RENDITIONS ACROSS FIRST or their signed URLs 404 while the rows still read
# `ready`. Also update the nginx CSP (media-src AND connect-src) at the same
# time — cross-origin audio is blocked by the browser with no server-side error.
# R2 presigns against the same endpoint it uploads to, so there is deliberately
# no AUDIO_S3_PUBLIC_ENDPOINT equivalent.
# e.g. https://<account-id>.r2.cloudflarestorage.com
AUDIO_S3_ENDPOINT=
AUDIO_S3_ACCESS_KEY=
AUDIO_S3_SECRET_KEY=
AUDIO_S3_BUCKET=
# R2 expects 'auto' (the default when AUDIO_S3_ENDPOINT is set).
AUDIO_S3_REGION=

# Auth (JWT) — RS256 recommended for production
# Option A: File paths to PEM keys
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=
# Option B: Base64-encoded PEM keys (single-line, for environments without file access)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Option C: Symmetric secret (dev fallback only — NOT for production)
JWT_SECRET=change-me-to-a-strong-random-secret-at-least-32-chars
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
ENCRYPTION_KEY=change-me-to-a-real-aes-256-gcm-key

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback
# Mobile social login (ID-token exchange) — optional platform client IDs added
# to the Google audience allowlist; Apple bundle ID is the identity-token audience
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
APPLE_BUNDLE_ID=com.libertasian.app

# SMTP (Brevo — https://app.brevo.com, SMTP & API → SMTP keys)
# Falls back to console logging in dev when SMTP_HOST is empty.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=LIBERTASIAN <noreply@libertasian.com>

# AI Services
VLLM_BASE_URL=http://localhost:8000/v1
EMBEDDING_SERVICE_URL=http://localhost:8001
RAG_SERVICE_URL=http://localhost:8000
OCR_SERVICE_URL=http://localhost:8002

# RAG Service — OpenAI API (primary LLM provider; leave empty to use vLLM fallback)
RAG_OPENAI_API_KEY=
RAG_OPENAI_MODEL=gpt-4o-mini
RAG_OPENAI_REQUEST_TIMEOUT=120

# RAG Service — OpenSearch
# Credentials fall back to the unprefixed OPENSEARCH_USERNAME / OPENSEARCH_PASSWORD
# above, so nothing needs to be set here for the service to authenticate. Set the
# RAG_-prefixed names ONLY to point the RAG service at different credentials than
# the rest of the stack. Prod serves https:// with a self-signed cert on the
# internal network, which is why VERIFY_SSL defaults to false — flip it to true
# once a real cert is issued.
RAG_OPENSEARCH_URL=http://localhost:9200
# RAG_OPENSEARCH_USERNAME=
# RAG_OPENSEARCH_PASSWORD=
RAG_OPENSEARCH_VERIFY_SSL=false

# Query embedding for the kNN retrieval leg. RAG_-prefixed: the RAG service's
# Settings uses env_prefix="RAG_", so the unprefixed EMBEDDING_SERVICE_URL above
# is read by the worker, not by rag-service. Leave EMPTY to run retrieval
# BM25-only — that is a supported mode, reported as `knn:not_configured` on
# every SearchResult, not an error.
# RAG_EMBEDDING_SERVICE_URL=http://localhost:8001
RAG_EMBEDDING_REQUEST_TIMEOUT=5
# Must equal EMBEDDING_DIM and the dimension baked into legal_documents_vector.
# Changing it means a reindex.
RAG_EMBEDDING_DIM=384

# Cross-encoder reranking of the fused candidate set. Leave EMPTY to keep RRF
# ordering — supported, reported as `reranker:not_configured`, not an error.
# RAG_RERANKER_URL=http://localhost:8002
RAG_RERANKER_TIMEOUT=10

# Reranker Service (cross-encoder)
# Model is baked into the image at build time; changing this name requires
# rebuilding with --build-arg RERANKER_MODEL_NAME, because the runtime sets
# HF_HUB_OFFLINE=1 and will not download a different one.
RERANKER_MODEL_NAME=BAAI/bge-reranker-base
RERANKER_DEVICE=cpu

# Worker Service (Celery)
WORKER_REDIS_URL=redis://localhost:6379/0
WORKER_CELERY_RESULT_BACKEND=redis://localhost:6379/1
WORKER_DATABASE_URL=postgresql://libertasian:libertasian_dev@localhost:5432/libertasian
WORKER_OCR_SERVICE_URL=http://localhost:8002
WORKER_RAG_SERVICE_URL=http://localhost:8000
WORKER_EMBEDDING_SERVICE_URL=http://localhost:8001
WORKER_S3_ENDPOINT=http://localhost:9000
WORKER_S3_ACCESS_KEY=libertasian
WORKER_S3_SECRET_KEY=libertasian_dev_secret
WORKER_S3_BUCKET_UPLOADS=libertasian-uploads
WORKER_S3_BUCKET_CORPUS=libertasian-corpus

# Internal API Key (worker-service → NestJS service-to-service auth)
INTERNAL_API_KEY=dev-internal-api-key
WORKER_INTERNAL_API_KEY=dev-internal-api-key
WORKER_NESTJS_API_URL=http://localhost:3001/api/v1

# Feature flag — public /derivatives (student Library) endpoints.
# Keep 'false' in prod until editorial has approved a baseline batch of
# derivatives; 'true' in staging for QA.
FEATURE_DERIVATIVES_PUBLIC=false

# ClamAV (malware scanning)
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=30000
CLAMAV_ENABLED=true

# Billing
# Which gateway adapter is bound to the PAYMENT_PROVIDER port. Also the
# `:provider` segment of the webhook URL: POST /billing/webhooks/<slug>.
PAYMENT_PROVIDER=xendit

# Billing (Xendit)
XENDIT_SECRET_KEY=xnd_development_change_me
XENDIT_WEBHOOK_CALLBACK_TOKEN=callback_token_change_me

# ISR Revalidation (API → Web, for admin plan edits)
REVALIDATION_SECRET=change-me-to-a-random-secret
WEB_BASE_URL=http://localhost:3000

# Dynamic Pricing (set false to force static fallback)
DYNAMIC_PRICING_ENABLED=true

# Monitoring
SENTRY_DSN=
