# ===========================================
# LIBERTASIAN — Environment Variables Template
# Copy to .env and fill in actual values
# ===========================================

# Core
NODE_ENV=development
APP_PORT=3001
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# Database (PostgreSQL 16 + pgvector)
DATABASE_URL=postgresql://libertasian:libertasian_dev@localhost:5432/libertasian?schema=public
DATABASE_READ_REPLICA_URL=postgresql://readonly:libertasian_dev@localhost:5432/libertasian
DATABASE_POOL_SIZE=20

# Redis
REDIS_URL=redis://localhost:6379/0

# OpenSearch
OPENSEARCH_URL=https://localhost:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=LibertasianDev2024!

# Object Storage (MinIO — S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=libertasian
S3_SECRET_KEY=libertasian_dev_secret
S3_BUCKET_UPLOADS=libertasian-uploads
S3_BUCKET_CORPUS=libertasian-corpus

# Amazon Polly (Audio narration)
# Credentials are optional — the default AWS provider chain (env, shared
# config, IAM role) is used when these are unset.
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Matthew is a neural voice compatible with the default 'neural' engine.
POLLY_VOICE_ID=Matthew
POLLY_ENGINE=neural
# Wrap neural SSML in <amazon:domain name="news"> for a newscaster delivery.
# Set to 'false' to disable. Ignored on generative/long-form engines.
POLLY_NEWSCASTER=true

# Auth (JWT) — RS256 recommended for production
# Option A: File paths to PEM keys
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=
# Option B: Base64-encoded PEM keys (single-line, for environments without file access)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Option C: Symmetric secret (dev fallback only — NOT for production)
JWT_SECRET=change-me-to-a-strong-random-secret-at-least-32-chars
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
ENCRYPTION_KEY=change-me-to-a-real-aes-256-gcm-key

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# SMTP (optional — falls back to console logging in dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=LIBERTASIAN <noreply@libertasian.com>

# AI Services
VLLM_BASE_URL=http://localhost:8000/v1
EMBEDDING_SERVICE_URL=http://localhost:8001
RAG_SERVICE_URL=http://localhost:8000
OCR_SERVICE_URL=http://localhost:8002

# RAG Service — OpenAI API (primary LLM provider; leave empty to use vLLM fallback)
RAG_OPENAI_API_KEY=
RAG_OPENAI_MODEL=gpt-4o-mini
RAG_OPENAI_REQUEST_TIMEOUT=120

# Worker Service (Celery)
WORKER_REDIS_URL=redis://localhost:6379/0
WORKER_CELERY_RESULT_BACKEND=redis://localhost:6379/1
WORKER_DATABASE_URL=postgresql://libertasian:libertasian_dev@localhost:5432/libertasian
WORKER_OCR_SERVICE_URL=http://localhost:8002
WORKER_RAG_SERVICE_URL=http://localhost:8000
WORKER_EMBEDDING_SERVICE_URL=http://localhost:8001
WORKER_S3_ENDPOINT=http://localhost:9000
WORKER_S3_ACCESS_KEY=libertasian
WORKER_S3_SECRET_KEY=libertasian_dev_secret
WORKER_S3_BUCKET_UPLOADS=libertasian-uploads
WORKER_S3_BUCKET_CORPUS=libertasian-corpus

# Internal API Key (worker-service → NestJS service-to-service auth)
INTERNAL_API_KEY=dev-internal-api-key
WORKER_INTERNAL_API_KEY=dev-internal-api-key
WORKER_NESTJS_API_URL=http://localhost:3001/api/v1

# Feature flag — public /derivatives (student Library) endpoints.
# Keep 'false' in prod until editorial has approved a baseline batch of
# derivatives; 'true' in staging for QA.
FEATURE_DERIVATIVES_PUBLIC=false

# ClamAV (malware scanning)
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=30000
CLAMAV_ENABLED=true

# Billing (Xendit)
XENDIT_SECRET_KEY=xnd_development_change_me
XENDIT_WEBHOOK_CALLBACK_TOKEN=callback_token_change_me

# ISR Revalidation (API → Web, for admin plan edits)
REVALIDATION_SECRET=change-me-to-a-random-secret
WEB_BASE_URL=http://localhost:3000

# Dynamic Pricing (set false to force static fallback)
DYNAMIC_PRICING_ENABLED=true

# Monitoring
SENTRY_DSN=
